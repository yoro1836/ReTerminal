# ReTerminal Debian VM: SMP + container/systemd basics
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_PSI=y
CONFIG_FUSE_FS=y
CONFIG_CUSE=y
CONFIG_BINFMT_MISC=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=y
CONFIG_TUN=y
CONFIG_WIREGUARD=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_VXLAN=y
CONFIG_DUMMY=y
CONFIG_IO_URING=y
CONFIG_AIO=y
CONFIG_USERFAULTFD=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_FANOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_CGROUP_HUGETLB=n
CONFIG_CPUSETS=y
CONFIG_CGROUP_PERF=n
CONFIG_SYSVIPC=y
CONFIG_BSD_PROCESS_ACCT=y
CONFIG_TASKSTATS=y
CONFIG_AUDIT=y
CONFIG_SECURITYFS=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSWAP=y
CONFIG_ZSMALLOC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_PACKET=y
CONFIG_UNIX_DIAG=y
CONFIG_INET_DIAG=y
CONFIG_NETLINK_DIAG=y
# Loadable modules (installed into the guest's /lib/modules by vm-login.sh)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=n
CONFIG_MODULE_SIG=n
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_NBD=m
CONFIG_ZRAM=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_NTFS3_FS=m
CONFIG_F2FS_FS=m
CONFIG_HFSPLUS_FS=m
CONFIG_EROFS_FS=m
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_USER_API_AEAD=m
CONFIG_NET_SCH_CAKE=m
CONFIG_NET_SCH_NETEM=m
CONFIG_TCP_CONG_HTCP=m
CONFIG_TCP_CONG_VEGAS=m
