--- a/arch/arm64/um/Kconfig
+++ b/arch/arm64/um/Kconfig
@@ -104,3 +104,14 @@ config GENERIC_CSUM
 # exist for a UML guest, which is an ordinary userspace process. The subarch
 # advertises itself as UML_ARM64 instead, exactly as x86 UML would if it were
 # written today, and selects the individual capabilities it really has.
+
+config UML_FASTPATH
+	bool "Rewrite hot guest syscall sites (SECCOMP mode)"
+	default y
+	help
+	  In SECCOMP mode every guest syscall costs a host SIGSYS delivery and
+	  an rt_sigreturn on top of the stub<->kernel handoff. With this, a
+	  "mov w8, #nr; svc #0" site that has trapped 64 times is rewritten
+	  (copy-on-write, in that process only) to branch into a trampoline
+	  that enters the stub directly. Same idea as tawcroot's
+	  TAWCROOT_FASTPATH. Boot with fastpath=0 to turn it off.
