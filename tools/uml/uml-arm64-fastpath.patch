+/*
+ * Make [addr, addr + len) usable by the host itself once the mm is synced:
+ * a host syscall run in the stub (host device passthrough) gets EFAULT where
+ * the guest would take a fault, so the pages must be present, young and, for
+ * writing, dirty. Reclaim can still undo it before the sync; callers retry.
+ */
+int um_user_prefault(unsigned long addr, unsigned long len, int is_write)
+{
+	unsigned long a = addr & PAGE_MASK, end = addr + len;
+	int code;
+
+	if (!len)
+		return 0;
+	if (end < addr || end > TASK_SIZE)
+		return -EFAULT;
+
+	for (; a < end; a += PAGE_SIZE) {
+		pte_t *pte = virt_to_pte(current->mm, a);
+
+		if (pte && pte_present(*pte) && pte_young(*pte) &&
+		    (!is_write || (pte_write(*pte) && pte_dirty(*pte))))
+			continue;
+		if (handle_page_fault(a, 0, is_write, 1, &code))
+			return -EFAULT;
+	}
+	return 0;
+}
