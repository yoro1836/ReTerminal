diff --git a/arch/um/os-Linux/skas/mem.c b/arch/um/os-Linux/skas/mem.c
index ee1c2763bef6..4d3040727522 100644
--- a/arch/um/os-Linux/skas/mem.c
+++ b/arch/um/os-Linux/skas/mem.c
@@ -343,3 +343,77 @@ int unmap(struct mm_id *mm_idp, unsigned long addr, unsigned long len)
 
 	return 0;
 }
+
+/*
+ * Run ioctl(fd, cmd, ...) on a host fd inside the stub, where pointers the
+ * host follows are guest addresses. With @buf the argument is @size bytes
+ * bounced through the stub data page (copied in and back out), else @arg is
+ * passed as is. The caller holds the turnstile. Returns the host's result.
+ */
+unsigned long stub_host_ioctl_max(void)
+{
+	struct stub_data *d = NULL;
+
+	return sizeof(d->syscall_data) - sizeof(d->syscall_data[0]);
+}
+
+long stub_host_ioctl(struct mm_id *mm_idp, int fd, unsigned long cmd,
+		     unsigned long arg, void *buf, unsigned long size)
+{
+	struct stub_data *d = (void *)mm_idp->stack;
+	struct stub_syscall *sc;
+	long ret;
+	int idx;
+
+	if (!using_seccomp)
+		return -ENOSYS;
+	if (buf && size > stub_host_ioctl_max())
+		return -E2BIG;
+
+	if (mm_idp->syscall_data_len > 0)
+		do_syscall_stub(mm_idp);
+	if (mm_idp->syscall_data_len < 0)
+		return -EFAULT;
+
+	idx = get_stub_fd(mm_idp, fd);
+	sc = syscall_stub_alloc(mm_idp);
+	sc->syscall = STUB_SYSCALL_IOCTL;
+	sc->mem.fd = idx;
+	sc->mem.addr = cmd;
+	if (buf) {
+		memcpy(&d->syscall_data[1], buf, size);
+		sc->mem.offset = STUB_DATA +
+			offsetof(struct stub_data, syscall_data[1]);
+	} else {
+		sc->mem.offset = arg;
+	}
+
+	if (do_syscall_stub(mm_idp) < 0)
+		return -EFAULT;
+
+	ret = d->syscall_data[0].mem.length;
+	if (buf)
+		memcpy(buf, &d->syscall_data[1], size);
+	return ret;
+}
+
+/* Would the host let a stub map this? Checked here so mmap can fail cleanly. */
+int os_mmap_probe(int fd, unsigned long long offset, unsigned long len,
+		  int prot)
+{
+	void *p = mmap(NULL, len, prot, MAP_SHARED, fd, offset);
+
+	if (p == MAP_FAILED)
+		return -errno;
+	munmap(p, len);
+	return 0;
+}
+
+/* A mapping of a host fd range for the kernel itself, NULL if refused. */
+void *os_mmap_shared(int fd, unsigned long long offset, unsigned long len,
+		     int prot)
+{
+	void *p = mmap(NULL, len, prot, MAP_SHARED, fd, offset);
+
+	return p == MAP_FAILED ? NULL : p;
+}
