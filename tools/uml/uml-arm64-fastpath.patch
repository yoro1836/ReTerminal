+		"xor	%%esi, %%esi\n"
+		"xor	%%edx, %%edx\n"
+		"xor	%%r10d, %%r10d\n"
+		"xor	%%r8d, %%r8d\n"
+		"syscall\n"
+		"test	%%rax, %%rax\n"
+		"jnz	1f\n"
+		"mov	%%r12, %%rdi\n"
+		"mov	%%r13, %%rsi\n"
+		"mov	$3, %%edx\n"		/* PROT_READ | PROT_WRITE */
+		"mov	$0x11, %%r10d\n"	/* MAP_SHARED | MAP_FIXED */
+		"mov	$3, %%r8d\n"		/* STUB_PHYSMEM_FD */
+		"mov	%%r14, %%r9\n"
+		"mov	$9, %%eax\n"		/* __NR_mmap */
+		"syscall\n"
+		"cmp	%%rax, %%r12\n"
+		"je	2f\n"
+		"mov	$39, %%eax\n"		/* getpid: not allowed, killed */
+		"syscall\n"
+		"2:\n"
+		"mov	%%rbx, %%rsp\n"
+		"mov	%%r15, %%rdi\n"
+		"jmp	stub_clone_child\n"
+		"1:\n"
+		: "=a" (ret)
+		: "0" ((long)__NR_clone), "D" (0x00008000L), "b" (sp),
+		  "r" (r12), "r" (r13), "r" (r14), "r" (r15)
+		: "rsi", "rdx", "r8", "r9", "r10", "r11", "rcx", "memory");
+
+	return ret;
+}
