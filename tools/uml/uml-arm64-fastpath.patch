+/* The range is going away; the stub drops it at the next sync. */
+void um_hostmap_del(struct mm_struct *mm, struct um_hostmap *m)
+{
+	scoped_guard(spinlock_irqsave, &mm->context.sync_tlb_lock) {
+		if (m->mapped) {
+			m->dead = true;
+			return;
+		}
+		list_del(&m->list);
+	}
+	um_hostmap_free(m);
+}
+
+/* A guest fault on a host mapping: 0 if mapping it again is the answer. */
+int um_hostmap_fault(struct mm_struct *mm, unsigned long addr)
+{
+	struct um_hostmap *m;
+
+	guard(spinlock_irqsave)(&mm->context.sync_tlb_lock);
+	m = um_hostmap_find(mm, addr);
+	if (!m)
+		return -ENOENT;
+
+	/* The host keeps refusing the access: let the guest have its signal */
+	if (time_after(jiffies, m->fault_jiffies + HZ))
+		m->faults = 0;
+	m->fault_jiffies = jiffies;
+	if (++m->faults > 256)
+		return -EFAULT;
+
+	m->need_map = true;
+	return 0;
+}
+
+void um_hostmap_destroy(struct mm_struct *mm)
+{
+	struct um_hostmap *m, *tmp;
+
+	if (!mm->context.hostmaps.next)
+		return;
+	list_for_each_entry_safe(m, tmp, &mm->context.hostmaps, list) {
+		list_del(&m->list);
+		um_hostmap_free(m);
+	}
+}
+
+/*
+ * Around the PTE walk of um_tlb_sync(): ranges that went away are unmapped
+ * before it, so pages the guest put there since are mapped after; new or
+ * faulted ranges are mapped after it, so a stale unmap of what was there
+ * before cannot hit them.
+ */
+static void um_hostmap_sync_dead(struct mm_struct *mm)
+{
+	struct um_hostmap *m, *tmp;
+
+	list_for_each_entry_safe(m, tmp, &mm->context.hostmaps, list) {
+		if (!m->dead)
+			continue;
+		unmap(&mm->context.id, m->start, m->end - m->start);
+		anchors_forget(mm, m->start, m->end);
+		list_del(&m->list);
+		um_hostmap_free(m);
+	}
