+	sec = tk->xtime_sec + tk->wall_to_monotonic.tv_sec;
+	nsec = r->xtime_nsec + ((u64)tk->wall_to_monotonic.tv_nsec << r->shift);
+	um_vdso_time_set(&d->mono, sec, nsec, r->shift);
+
+	sec = d->mono.sec +
+	      div_u64_rem(ktime_to_ns(tk->offs_boot), NSEC_PER_SEC, &rem);
+	nsec = d->mono.nsec + ((u64)rem << r->shift);
+	um_vdso_time_set(&d->boot, sec, nsec, r->shift);
