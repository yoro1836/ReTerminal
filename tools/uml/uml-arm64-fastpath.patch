+static void um_fix_stale(struct mm_struct *mm, pmd_t *pmd,
+			 unsigned long address, int is_write)
+{
+	spinlock_t *ptl;
+	pte_t *pte, v;
+
+	pte = pte_offset_map_lock(mm, pmd, address, &ptl);
+	if (!pte)
+		return;
+	v = *pte;
+	if ((pte_val(v) & (_PAGE_PRESENT | _PAGE_NEEDSYNC | _PAGE_ACCESSED)) ==
+	    (_PAGE_PRESENT | _PAGE_ACCESSED) &&
+	    (!is_write || (pte_write(v) && pte_dirty(v)))) {
+		pte_clear_bits(v, _PAGE_PROTONLY);
+		pte_set_bits(v, _PAGE_NEEDSYNC);
+		*pte = v;
+		address &= PAGE_MASK;
+		um_tlb_mark_sync(mm, address, address + PAGE_SIZE);
+		um_stale_fixes++;
+	}
+	pte_unmap_unlock(pte, ptl);
