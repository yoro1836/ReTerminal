-	if (sigprocmask(enable ? SIG_UNBLOCK : SIG_BLOCK, &sigset, NULL) < 0)
-		panic("%s: sigprocmask failed, errno = %d", __func__, errno);
-}
+/*
+ * IPIs that arrived while this CPU had IRQs off, one bit per vector. They
+ * used to be held off by blocking IPI_SIGNAL on the host, but that made
+ * every local_irq_disable()/enable() pair two host sigprocmask() calls.
+ * Now, like SIGIO and SIGALRM, the handler only notes them and
+ * unblock_signals() runs them.
