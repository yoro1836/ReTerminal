+
+static void zygote_start(struct stub_data *any_stub_data)
+{
+	struct tramp_data td = { .stub_data = any_stub_data, .zygote = 1 };
+	void *stack;
+	int pid, i;
+
+	zygote_state = -1;
+	stack = mmap(NULL, UM_KERN_PAGE_SIZE, PROT_READ | PROT_WRITE,
+		     MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+	if (stack == MAP_FAILED)
+		return;
+	if (socketpair(AF_UNIX, SOCK_STREAM, 0, td.sockpair)) {
+		munmap(stack, UM_KERN_PAGE_SIZE);
+		return;
+	}
+	pid = clone(userspace_tramp, stack + UM_KERN_PAGE_SIZE,
+		    CLONE_VFORK | CLONE_VM | SIGCHLD, &td);
+	munmap(stack, UM_KERN_PAGE_SIZE);
+	close(td.sockpair[0]);
+	if (pid < 0) {
+		close(td.sockpair[1]);
+		return;
+	}
+	fcntl(td.sockpair[1], F_SETFD, FD_CLOEXEC);
+	zygote_sock = td.sockpair[1];
+	zygote_state = 1;
+	printk(UM_KERN_INFO "stub zygote: pid %d, %d spares\n", pid,
+	       ZYGOTE_SPARES);
+	for (i = 0; i < ZYGOTE_SPARES; i++)
+		zygote_ask();
+}
+
+/*
+ * Hand a new mm to a spare stub. Returns its pid, or <0 to start one from
+ * scratch instead.
+ */
+static int zygote_spawn(struct stub_data *stub_data, int stub_sock)
+{
+	struct stub_init_data init_data;
+	struct iovec iov = { .iov_base = &init_data, .iov_len = sizeof(init_data) };
+	union {
+		char buf[CMSG_SPACE(sizeof(int))];
+		struct cmsghdr align;
+	} ctrl;
+	struct msghdr mh = {
+		.msg_iov = &iov,
+		.msg_iovlen = 1,
+		.msg_control = ctrl.buf,
+		.msg_controllen = sizeof(ctrl.buf),
+	};
+	struct cmsghdr *cm;
+	int pid, sock, n, i;
+
+	if (!using_seccomp || !zygote_on || zygote_state < 0)
+		return -1;
+	if (!zygote_state)
+		zygote_start(stub_data);
+	if (zygote_state < 0)
+		return -1;
