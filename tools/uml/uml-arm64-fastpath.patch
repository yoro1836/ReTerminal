-		uml_ncpus, host);
+	if (!uml_ncpus) {	/* else ncpus= was given; the operator decides */
+		host = os_nr_cpus_online();
+		uml_ncpus = clamp(host - 1, 1, NR_CPUS);
+		os_info("Using %d CPUs of the host's %d (ncpus= to override)\n",
+			uml_ncpus, host);
+	}
