+static long hostfd_ioctl_fd(int host_fd, unsigned int cmd, void *buf,
+			    __s32 *fdp, bool in, bool out)
+{
+	struct file *file = NULL;
+	long ret;
+
+	if (in) {
+		int fd = um_hostfd_of_fd(*fdp, &file);
+
+		if (fd < 0)
+			return fd;
+		*fdp = fd;
+	}
+	ret = hostdev_user_ioctl(host_fd, cmd, buf);
+	if (file)
+		fput(file);
+	if (!ret && out) {
+		int fd = hostfd_install(*fdp);
+
+		if (fd < 0)
+			return fd;
+		*fdp = fd;
+	}
+	return ret;
+}
