+
+	slots = syscall_stub_free_slots(&mm->context.id) - 2;
+	flags &= ~(FAULT_FLAG_ALLOW_RETRY | FAULT_FLAG_KILLABLE |
+		   FAULT_FLAG_INTERRUPTIBLE | FAULT_FLAG_TRIED);
+	flags |= FAULT_FLAG_WRITE;
