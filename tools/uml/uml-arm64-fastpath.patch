+__uml_setup("stub_zygote=", uml_stub_zygote_setup,
+"stub_zygote=<0|1>\n"
+"    In SECCOMP mode, keep pre-started stubs forked from one exec()ed stub\n"
+"    instead of starting one from scratch for every guest fork() and\n"
+"    execve(). Default: 1.\n\n");
+
+static void zygote_off(const char *why, int err)
+{
+	printk(UM_KERN_INFO "stub zygote off: %s (%d), exec()ing stubs\n",
+	       why, err);
+	if (zygote_sock >= 0)
+		close(zygote_sock);
+	zygote_sock = -1;
+	zygote_state = -1;
+	while (spare_n) {
+		spare_n--;
+		close(spare_sock[spare_n]);
+		kill(spare_pid[spare_n], SIGKILL);
