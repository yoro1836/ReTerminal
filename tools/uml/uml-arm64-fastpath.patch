+	"	str	x30, [x16, #240]\n"
+	"	ldp	x2, x3, [sp]\n"			/* guest x0, x1 */
+	"	stp	x2, x3, [x16, #0]\n"
+	"	ldp	x2, x3, [sp, #16]\n"		/* guest x16, x17 */
+	"	stp	x2, x3, [x16, #128]\n"
+	"	add	x2, sp, #32\n"			/* guest sp */
+	"	ldr	x3, [x17, #24]\n"		/* site + 4 */
+	"	stp	x2, x3, [x16, #248]\n"		/* mc sp, pc */
+	"	mrs	x4, nzcv\n"
+	"	str	x4, [x16, #264]\n"		/* mc pstate */
