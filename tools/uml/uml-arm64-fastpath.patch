+	list_for_each_entry(m, &mm->context.hostmaps, list) {
+		if (!m->need_map)
+			continue;
+		map(&mm->context.id, m->start, m->end - m->start, m->prot,
+		    m->fd, m->offset);
+		m->need_map = false;
+		m->mapped = true;
+	}
