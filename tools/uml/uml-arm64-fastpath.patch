+static int hostshm_open(struct inode *inode, struct file *file)
+{
+	struct hostfd *h = kzalloc(sizeof(*h), GFP_KERNEL);
+
+	if (!h)
+		return -ENOMEM;
+	h->fd = hostdev_user_memfd(4);
+	if (h->fd < 0) {
+		int err = h->fd;
+
+		kfree(h);
+		return err;
+	}
+	file->private_data = h;
+	return 0;
+}
+
+static const struct file_operations hostshm_fops = {
+	.owner = THIS_MODULE,
+	.open = hostshm_open,
+	.release = hostfd_release,
+	.mmap = hostfd_mmap,
+	.llseek = hostfd_llseek,
+};
