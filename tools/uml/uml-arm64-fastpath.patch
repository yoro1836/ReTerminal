--- a/arch/arm64/um/shared/sysdep/stub.h
+++ b/arch/arm64/um/shared/sysdep/stub.h
@@ -152,6 +152,59 @@ static __always_inline long stub_syscall6(long syscall, long arg1, long arg2,
 	return x0;
 }
 
+#define STUB_HAVE_CLONE
+#define STUB_CLONE_SP_BIAS 0
+
+/*
+ * STUB_SYSCALL_CLONE. The stack is in the data pages, which parent and child
+ * share until the child has mapped its own: the child must not touch memory
+ * before that, so everything it needs is in registers, and it goes on in
+ * stub_clone_child() on its new stack. Returns in the parent only.
+ */
+static __always_inline long stub_clone(unsigned long data, unsigned long len,
+				       unsigned long offset, long sock,
+				       unsigned long sp)
+{
+	register long x0 __asm__("x0") = 0x00008000;	/* CLONE_PARENT */
+	register long x1 __asm__("x1") = 0;
+	register long x2 __asm__("x2") = 0;
+	register long x3 __asm__("x3") = 0;
+	register long x4 __asm__("x4") = 0;
+	register long x8 __asm__("x8") = __NR_clone;
+	register long x9 __asm__("x9") = data;
+	register long x10 __asm__("x10") = len;
+	register long x11 __asm__("x11") = offset;
+	register long x12 __asm__("x12") = sock;
+	register long x13 __asm__("x13") = sp;
+
+	__asm__ volatile (
+		"svc	#0\n"
+		"cbnz	x0, 1f\n"
+		"mov	x0, x9\n"
+		"mov	x1, x10\n"
+		"mov	x2, #3\n"		/* PROT_READ | PROT_WRITE */
+		"mov	x3, #0x11\n"		/* MAP_SHARED | MAP_FIXED */
+		"mov	x4, #3\n"		/* STUB_PHYSMEM_FD */
+		"mov	x5, x11\n"
+		"mov	x8, #222\n"		/* __NR_mmap */
+		"svc	#0\n"
+		"cmp	x0, x9\n"
+		"b.eq	2f\n"
+		"mov	x8, #172\n"		/* getpid: not allowed, killed */
+		"svc	#0\n"
+		"2:\n"
+		"mov	sp, x13\n"
+		"mov	x0, x12\n"
+		"b	stub_clone_child\n"
+		"1:\n"
+		: "+r" (x0)
+		: "r" (x1), "r" (x2), "r" (x3), "r" (x4), "r" (x8), "r" (x9),
+		  "r" (x10), "r" (x11), "r" (x12), "r" (x13)
+		: "x5", "memory");
+
+	return x0;
+}
