+	d->ok = r->clock == &um_cntvct;
+	d->cycle_last = r->cycle_last;
+	d->mask = r->mask;
+	d->mult = r->mult;
+	d->shift = r->shift;
+
+	um_vdso_time_set(&d->real, tk->xtime_sec, r->xtime_nsec, r->shift);
