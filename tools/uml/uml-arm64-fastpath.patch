+static int zygote_on = 1;
+static int spare_pid[ZYGOTE_SPARES], spare_sock[ZYGOTE_SPARES], spare_n;
+static int spare_asked;		/* requested, not yet received */
+
+static int __init uml_stub_zygote_setup(char *line, int *add)
+{
+	*add = 0;
+	zygote_on = strtoul(line, NULL, 0) != 0;
+	return 0;
