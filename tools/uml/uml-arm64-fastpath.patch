+
+/* Small pointer-free ioctls (dma-buf sync, sync file), in the kernel process */
+static long hostfd_ioctl(struct file *file, unsigned int cmd,
+			 unsigned long arg)
+{
+	struct hostfd *h = file->private_data;
+	unsigned int size = _IOC_SIZE(cmd);
+	char buf[64];
+	long ret;
+
+	if (cmd != DMA_BUF_IOCTL_SYNC && cmd != DMA_BUF_IOCTL_EXPORT_SYNC_FILE &&
+	    cmd != DMA_BUF_IOCTL_IMPORT_SYNC_FILE && cmd != SYNC_IOC_MERGE)
+		return -ENOTTY;
+	memset(buf, 0, sizeof(buf));
+	if ((_IOC_DIR(cmd) & _IOC_WRITE) &&
+	    copy_from_user(buf, (void __user *)arg, size))
+		return -EFAULT;
+
+	if (cmd == SYNC_IOC_MERGE) {
+		struct sync_merge_data *m = (void *)buf;
+		struct file *f2;
+		int fd2 = um_hostfd_of_fd(m->fd2, &f2);
+
+		if (fd2 < 0)
+			return fd2;
+		m->fd2 = fd2;
+		ret = hostdev_user_ioctl(h->fd, cmd, buf);
+		fput(f2);
+		if (!ret) {
+			m->fence = hostfd_install(m->fence);
+			if (m->fence < 0)
+				ret = m->fence;
+		}
+	} else if (cmd == DMA_BUF_IOCTL_EXPORT_SYNC_FILE) {
+		struct dma_buf_export_sync_file *e = (void *)buf;
+
+		ret = hostfd_ioctl_fd(h->fd, cmd, buf, &e->fd, false, true);
+	} else if (cmd == DMA_BUF_IOCTL_IMPORT_SYNC_FILE) {
+		struct dma_buf_import_sync_file *e = (void *)buf;
+
+		ret = hostfd_ioctl_fd(h->fd, cmd, buf, &e->fd, true, false);
+	} else {
+		ret = hostdev_user_ioctl(h->fd, cmd, buf);
+	}
+	if ((_IOC_DIR(cmd) & _IOC_READ) &&
+	    copy_to_user((void __user *)arg, buf, size))
+		return -EFAULT;
+	return ret;
+}
+
+static int hostfd_release(struct inode *inode, struct file *file)
+{
+	struct hostfd *h = file->private_data;
+
+	os_close_file(h->fd);
+	kfree(h);
+	return 0;
+}
+
+static const struct file_operations hostfd_fops = {
+	.owner = THIS_MODULE,
+	.release = hostfd_release,
+	.unlocked_ioctl = hostfd_ioctl,
+	.mmap = hostfd_mmap,
+	.llseek = hostfd_llseek,
+};
