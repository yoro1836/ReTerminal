+/* sync_tlb_lock held */
+static struct um_hostmap *um_hostmap_find(struct mm_struct *mm,
+					  unsigned long addr)
+{
+	struct um_hostmap *m;
+
+	list_for_each_entry(m, &mm->context.hostmaps, list)
+		if (!m->dead && addr >= m->start && addr < m->end)
+			return m;
+	return NULL;
+}
+
+static void um_hostmap_free(struct um_hostmap *m)
+{
+	if (m->kaddr)
+		os_unmap_memory(m->kaddr, m->end - m->start);
+	kfree(m);
+}
+
+/*
+ * Kernel access to host device memory (uaccess.c): run @op on the kernel's
+ * own mapping of the same host range. The lock keeps the mapping alive, one
+ * page at most is touched under it. False if @addr is not such memory.
+ */
+bool um_hostmap_op(struct mm_struct *mm, unsigned long addr, int len,
+		   int is_write,
+		   int (*op)(unsigned long addr, int len, void *arg),
+		   void *arg, int *ret)
+{
+	struct um_hostmap *m;
+
+	guard(spinlock_irqsave)(&mm->context.sync_tlb_lock);
+	m = um_hostmap_find(mm, addr);
+	if (!m)
+		return false;
+
+	*ret = -1;
+	if (addr + len > m->end ||
+	    !(m->prot & (is_write ? UM_PROT_WRITE : UM_PROT_READ)))
+		return true;
+	if (!m->kaddr) {
+		m->kaddr = os_mmap_shared(m->fd, m->offset, m->end - m->start,
+					  m->prot);
+		if (!m->kaddr)
+			return true;
+	}
+	*ret = op((unsigned long)m->kaddr + (addr - m->start), len, arg);
+	return true;
+}
+
+void um_hostmap_add(struct mm_struct *mm, struct um_hostmap *m)
+{
+	m->mapped = false;
+	m->dead = false;
+	m->need_map = true;
+	m->faults = 0;
+	m->fault_jiffies = jiffies;
+
+	guard(spinlock_irqsave)(&mm->context.sync_tlb_lock);
+	list_add_tail(&m->list, &mm->context.hostmaps);
+}
+
+/* The range is going away; the stub drops it at the next sync. */
+void um_hostmap_del(struct mm_struct *mm, struct um_hostmap *m)
+{
+	scoped_guard(spinlock_irqsave, &mm->context.sync_tlb_lock) {
+		if (m->mapped) {
+			m->dead = true;
+			return;
+		}
+		list_del(&m->list);
+	}
+	um_hostmap_free(m);
+}
+
+/* A guest fault on a host mapping: 0 if mapping it again is the answer. */
+int um_hostmap_fault(struct mm_struct *mm, unsigned long addr)
+{
+	struct um_hostmap *m;
+
+	guard(spinlock_irqsave)(&mm->context.sync_tlb_lock);
+	m = um_hostmap_find(mm, addr);
+	if (!m)
+		return -ENOENT;
+
+	/* The host keeps refusing the access: let the guest have its signal */
+	if (time_after(jiffies, m->fault_jiffies + HZ))
+		m->faults = 0;
+	m->fault_jiffies = jiffies;
+	if (++m->faults > 256)
+		return -EFAULT;
+
+	m->need_map = true;
+	return 0;
+}
+
+void um_hostmap_destroy(struct mm_struct *mm)
+{
+	struct um_hostmap *m, *tmp;
+
+	if (!mm->context.hostmaps.next)
+		return;
+	list_for_each_entry_safe(m, tmp, &mm->context.hostmaps, list) {
+		list_del(&m->list);
+		um_hostmap_free(m);
+	}
+}
+
+/*
+ * Around the PTE walk of um_tlb_sync(): ranges that went away are unmapped
+ * before it, so pages the guest put there since are mapped after; new or
+ * faulted ranges are mapped after it, so a stale unmap of what was there
+ * before cannot hit them.
+ */
+static void um_hostmap_sync_dead(struct mm_struct *mm)
+{
+	struct um_hostmap *m, *tmp;
+
+	list_for_each_entry_safe(m, tmp, &mm->context.hostmaps, list) {
+		if (!m->dead)
+			continue;
+		unmap(&mm->context.id, m->start, m->end - m->start);
+		anchors_forget(mm, m->start, m->end);
+		list_del(&m->list);
+		um_hostmap_free(m);
+	}
+}
+
+static void um_hostmap_sync_new(struct mm_struct *mm)
+{
+	struct um_hostmap *m;
+
+	list_for_each_entry(m, &mm->context.hostmaps, list) {
+		if (!m->need_map)
+			continue;
+		map(&mm->context.id, m->start, m->end - m->start, m->prot,
+		    m->fd, m->offset);
+		m->need_map = false;
+		m->mapped = true;
+	}
+}
+
 static void um_tlb_anchor(struct vm_ops *ops, pmd_t *pmd, unsigned long addr)
 {
 	unsigned long chunk = addr & ~(ANCHOR_CHUNK - 1), va;
@@ -75,6 +218,8 @@ static void um_tlb_anchor(struct vm_ops *ops, pmd_t *pmd, unsigned long addr)
 		/* Not the page just unmapped: it is the one likely reused. */
