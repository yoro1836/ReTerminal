+	*ret = -1;
+	if (addr + len > m->end ||
+	    !(m->prot & (is_write ? UM_PROT_WRITE : UM_PROT_READ)))
+		return true;
+	if (!m->kaddr) {
+		m->kaddr = os_mmap_shared(m->fd, m->offset, m->end - m->start,
+					  m->prot);
+		if (!m->kaddr)
