diff --git a/arch/arm64/um/fastpath.c b/arch/arm64/um/fastpath.c
new file mode 100644
index 000000000000..51143d16d549
--- /dev/null
+++ b/arch/arm64/um/fastpath.c
@@ -0,0 +1,332 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Syscall-site fast path, kernel half (CONFIG_UML_FASTPATH).
+ *
+ * Counts SECCOMP-mode guest syscalls per call site and, once a site has
+ * trapped FP_THRESHOLD times, rewrites its "svc #0" into a branch to a
+ * trampoline slot that enters the stub without a host signal. The stub half,
+ * and the slot layout, are described in <sysdep/stub-fastpath.h>.
+ *
+ * Both writes go through FOLL_FORCE, like a debugger's breakpoint: the site's
+ * page is copied on write in this mm only, so the file and every other
+ * process keep the original instruction. Slots live in anonymous r-x pages
+ * mapped within branch range of the site, which fork() copies like any other
+ * memory, so a child inherits patched sites together with their slots.
+ *
+ * Any "svc #0" in ordinary text can be patched: the stub reads the number
+ * from x8 like the host would, so wrappers such as libc's syscall() qualify
+ * too. A site is not patched while it is being used for a call that replaces
+ * or ends the whole register state, but whatever later comes through a slot
+ * is still safe: the stub falls back to a real rt_sigreturn whenever the
+ * kernel resumes anywhere but right after the site, on the same stack.
+ */
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/mman.h>
+#include <linux/highmem.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/mutex.h>
+#include <linux/hash.h>
+#include <linux/sched.h>
+#include <linux/uaccess.h>
+#include <linux/ptrace.h>
+#include <linux/security.h>
+#include <asm/mmu.h>
+#include <asm/unistd.h>
+#include <as-layout.h>
+#include <init.h>
+#include <skas.h>
+#include <stub-data.h>
+
+#define FP_THRESHOLD	64
+#define FP_SITES	256	/* per mm, open addressing */
+#define FP_PROBE	8
+#define FP_DONE		UINT_MAX
+#define FP_MAX_PAGES	16
+#define FP_SLOT_SIZE	32
+#define FP_SLOTS	((PAGE_SIZE - 8) / FP_SLOT_SIZE)
+#define FP_RANGE	(120UL << 20)	/* b reaches +-128 MiB */
+/*
+ * The host has its own mmap_min_addr (32 KiB on Android) that the guest does
+ * not know about: a slot page below it can never be mapped by the stub, and
+ * the failed mmap silently drops the rest of that sync batch.
+ */
+#define FP_LOW_FLOOR	(1UL << 20)
+
+#define INSN_SVC0	0xd4000001u
+
+struct um_fastpath {
+	spinlock_t lock;	/* site table */
+	struct mutex patch;	/* slot pages; patching sleeps */
+	unsigned int npages;
+	unsigned long page[FP_MAX_PAGES];
+	unsigned int used[FP_MAX_PAGES];
+	unsigned long site[FP_SITES];
+	unsigned int count[FP_SITES];
+};
+
+extern char __syscall_stub_start[];
+extern char stub_fast_entry[];
+
+static int fastpath_on = 1;
+static unsigned long fastpath_patched;
+
+static int __init uml_fastpath_setup(char *line, int *add)
+{
+	fastpath_on = simple_strtoul(line, NULL, 0);
+	return 0;
+}
+__uml_setup("fastpath=", uml_fastpath_setup,
+"fastpath=<0|1>\n"
+"    In SECCOMP mode, rewrite guest syscall sites that trap often so they\n"
+"    enter the stub without a host signal. Default: 1.\n\n");
+
+static bool fp_excluded(long nr)
+{
+	switch (nr) {
+	case __NR_rt_sigreturn:
+	case __NR_clone:
+	case __NR_clone3:
+	case __NR_execve:
+	case __NR_execveat:
+	case __NR_exit:
+	case __NR_exit_group:
+		return true;
+	}
+	return nr < 0 || nr > 0xffff;
+}
+
+/* Write @len bytes of code into @mm at @addr, breaking COW as ptrace would. */
+static int fp_poke(struct mm_struct *mm, unsigned long addr,
+		   const void *buf, size_t len)
+{
+	struct page *page;
+	void *k;
+	long got;
+
+	if (offset_in_page(addr) + len > PAGE_SIZE)
+		return -EINVAL;
+
+	mmap_read_lock(mm);
+	got = get_user_pages_remote(mm, addr, 1, FOLL_WRITE | FOLL_FORCE,
+				    &page, NULL);
+	mmap_read_unlock(mm);
+	if (got != 1)
+		return -EFAULT;
+
+	k = kmap_local_page(page) + offset_in_page(addr);
+	memcpy(k, buf, len);
+	/* Same physical page as the stub's mapping: make the I-side see it. */
+	__builtin___clear_cache(k, k + len);
+	kunmap_local(k);
+	put_page(page);
+	return 0;
+}
+
+static unsigned long fp_new_page(struct mm_struct *mm, unsigned long site)
+{
+	struct vm_unmapped_area_info info = {};
+	unsigned long addr, entry;
+	unsigned long lo = site > FP_RANGE ? site - FP_RANGE : 0;
+	unsigned long hi = min(site + FP_RANGE, (unsigned long)TASK_SIZE);
+
+	/* vm_unmapped_area() hands back low_limit as it is: keep it aligned */
+	lo = max(PAGE_ALIGN(lo), PAGE_ALIGN(max(mmap_min_addr, FP_LOW_FLOOR)));
+	hi &= PAGE_MASK;
+	info.length = PAGE_SIZE;
+	info.low_limit = lo;
+	info.high_limit = hi;
+
+	mmap_read_lock(mm);
+	addr = vm_unmapped_area(&info);
+	mmap_read_unlock(mm);
+	if (IS_ERR_VALUE(addr))
+		return 0;
+
+	addr = vm_mmap(NULL, addr, PAGE_SIZE, PROT_READ | PROT_EXEC,
+		       MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, 0);
+	if (IS_ERR_VALUE(addr))
+		return 0;
+
+	entry = STUB_CODE + (stub_fast_entry - __syscall_stub_start);
+	if (fp_poke(mm, addr + PAGE_SIZE - 8, &entry, sizeof(entry))) {
+		vm_munmap(addr, PAGE_SIZE);
+		return 0;
+	}
+	return addr;
+}
+
+static long fp_dist(unsigned long a, unsigned long b)
+{
+	return (long)(a - b);
+}
+
+/* A free slot within branch range of @site, or 0. */
+static unsigned long fp_get_slot(struct mm_struct *mm, struct um_fastpath *fp,
+				 unsigned long site)
+{
+	unsigned long page;
+	unsigned int i;
+
+	for (i = 0; i < fp->npages; i++) {
+		long d = fp_dist(fp->page[i], site);
+
+		if (fp->used[i] < FP_SLOTS && d > -(long)FP_RANGE &&
+		    d < (long)FP_RANGE)
+			return fp->page[i] + FP_SLOT_SIZE * fp->used[i]++;
+	}
+
+	if (fp->npages == FP_MAX_PAGES)
+		return 0;
+	page = fp_new_page(mm, site);
+	if (!page)
+		return 0;
+	fp->page[fp->npages] = page;
+	fp->used[fp->npages] = 1;
+	fp->npages++;
+	return page;
+}
+
+static int fp_patch(struct mm_struct *mm, struct um_fastpath *fp,
+		    unsigned long site, long nr)
+{
+	struct vm_area_struct *vma;
+	unsigned long slot, ret = site + 4;
+	u32 insn, code[8], b;
+	bool ok;
+
+	if (copy_from_user(&insn, (void __user *)site, 4))
+		return -EFAULT;
+	if (insn != INSN_SVC0)
+		return -EINVAL;
+
+	/* File-backed, private, executable, not writable: ordinary text. */
+	mmap_read_lock(mm);
+	vma = vma_lookup(mm, site);
+	ok = vma && vma->vm_file && (vma->vm_flags & VM_EXEC) &&
+	     !(vma->vm_flags & (VM_WRITE | VM_SHARED));
+	mmap_read_unlock(mm);
+	if (!ok)
+		return -EINVAL;
+
+	slot = fp_get_slot(mm, fp, site);
+	if (!slot)
+		return -ENOSPC;
+
+	code[0] = 0xa9bf47f0;				/* stp x16, x17, [sp, #-16]! */
+	code[1] = 0x10fffff1;				/* adr x17, slot */
+	code[2] = 0x58000010 |				/* ldr x16, <entry> */
+		  ((((slot & PAGE_MASK) + PAGE_SIZE - 8 - (slot + 8)) >> 2) << 5);
+	code[3] = 0xd61f0200;				/* br x16 */
+	code[4] = 0xa8c147f0;				/* ldp x16, x17, [sp], #16 */
+	code[5] = 0x14000000 |				/* b site + 4 */
+		  (((ret - (slot + 20)) >> 2) & 0x03ffffff);
+	code[6] = lower_32_bits(ret);			/* .quad site + 4 */
+	code[7] = upper_32_bits(ret);
+	if (fp_poke(mm, slot, code, sizeof(code)))
+		return -EFAULT;
+
+	/* svc and b may both be swapped under a running thread. */
+	b = 0x14000000 | (((slot - site) >> 2) & 0x03ffffff);
+	if (fp_poke(mm, site, &b, sizeof(b)))
+		return -EFAULT;
+
+	fastpath_patched++;
+	return 0;
+}
+
+/*
+ * Called before every resume, after the mm is synced. The fast return stores
+ * x16/x17 just below the guest sp with fast_busy set, where a fault kills the
+ * stub. Another thread's fork() may have write-protected that page while this
+ * one was in its syscall, so only allow it when the host mapping is writable.
+ */
+void um_fastpath_resume(void)
+{
+	struct mm_struct *mm = current->mm;
+	const unsigned long need = _PAGE_PRESENT | _PAGE_RW | _PAGE_ACCESSED |
+				   _PAGE_DIRTY;
+	struct stub_data *d;
+	pte_t *pte;
+
+	if (!mm)
+		return;
+	d = (struct stub_data *)mm->context.id.stack;
+	if (!d->fast_busy)
+		return;
+	pte = virt_to_pte(mm, PT_REGS_SP(&current->thread.regs) - 16);
+	d->fast_slow = !pte ||
+		(pte_val(*pte) & (need | _PAGE_NEEDSYNC | _PAGE_PROTONLY)) != need;
+}
+
+/* Called for every SECCOMP-mode guest syscall, before it runs. */
+void um_fastpath_syscall(unsigned long pc, long nr)
+{
+	struct mm_struct *mm = current->mm;
+	struct um_fastpath *fp;
+	unsigned long site = pc - 4;
+	unsigned int h, i, slot = FP_SITES;
+	bool patch = false;
+
+	if (!fastpath_on || !using_seccomp || !mm || fp_excluded(nr) ||
+	    (current->ptrace & PT_PTRACED))
+		return;
+
+	/* Entered through a slot: the site is patched already. */
+	if (((struct stub_data *)mm->context.id.stack)->fast_busy)
+		return;
+
+	fp = READ_ONCE(mm->context.fastpath);
+	if (!fp) {
+		struct um_fastpath *new = kzalloc(sizeof(*new), GFP_KERNEL);
+
+		if (!new)
+			return;
+		spin_lock_init(&new->lock);
+		mutex_init(&new->patch);
+		fp = cmpxchg(&mm->context.fastpath, NULL, new);
+		if (fp)
+			kfree(new);
+		else
+			fp = new;
+	}
+
+	h = hash_long(site, ilog2(FP_SITES));
+	spin_lock(&fp->lock);
+	for (i = 0; i < FP_PROBE; i++) {
+		unsigned int j = (h + i) % FP_SITES;
+
+		if (fp->site[j] == site || !fp->site[j]) {
+			slot = j;
+			break;
+		}
+	}
+	if (slot < FP_SITES && fp->count[slot] != FP_DONE) {
+		fp->site[slot] = site;
+		if (++fp->count[slot] >= FP_THRESHOLD) {
+			/* One attempt per site, whatever it gives. */
+			fp->count[slot] = FP_DONE;
+			patch = true;
+		}
+	}
+	spin_unlock(&fp->lock);
+
+	if (patch) {
+		int r;
+
+		mutex_lock(&fp->patch);
+		r = fp_patch(mm, fp, site, nr);
+		mutex_unlock(&fp->patch);
+		if (fastpath_on > 1 || (r && r != -EINVAL))
+			printk(KERN_INFO "fastpath: %s[%d] site %lx nr %ld: %d\n",
+			       current->comm, current->pid, site, nr, r);
+	}
+}
+
+void um_fastpath_destroy(struct mm_struct *mm)
+{
+	kfree(mm->context.fastpath);
+	mm->context.fastpath = NULL;
+}
