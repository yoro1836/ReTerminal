 1 file changed, 44 insertions(+), 16 deletions(-)

diff --git a/arch/um/kernel/tlb.c b/arch/um/kernel/tlb.c
index c58d950e6de0..5fd93232042a 100644
--- a/arch/um/kernel/tlb.c
+++ b/arch/um/kernel/tlb.c
@@ -81,6 +81,46 @@ static void um_tlb_anchor(struct vm_ops *ops, pmd_t *pmd, unsigned long addr)
 	}
 }
 
+/*
+ * An upper-level table went away, so the guest has nothing mapped in its
+ * whole span (always >= one chunk). If only part of addr's chunk was
+ * unmapped on the host, anchor a page of that chunk outside [addr, end).
+ */
+static void um_tlb_anchor_hole(struct vm_ops *ops, unsigned long addr,
+			       unsigned long end)
+{
+	unsigned long chunk = addr & ~(ANCHOR_CHUNK - 1), va;
+	unsigned long *slot = anchor_slot(ops->mm, addr);
+
+	BUILD_BUG_ON(PMD_SIZE < ANCHOR_CHUNK);
+
+	if (*slot && (*slot & ~(ANCHOR_CHUNK - 1)) == chunk)
+		return;
+	if (chunk < ANCHOR_FLOOR || chunk + ANCHOR_CHUNK > TASK_SIZE)
+		return;
+
+	if (addr > chunk)
+		va = chunk;
+	else if (end < chunk + ANCHOR_CHUNK)
+		va = chunk + ANCHOR_CHUNK - PAGE_SIZE;
+	else
+		return;
+
+	if (!ops->anchor(ops->mm_idp, va, PAGE_SIZE))
+		*slot = va;
+}
+
+static void um_tlb_unmap_hole(struct vm_ops *ops, unsigned long addr,
+			      unsigned long end, int *ret)
+{
+	*ret = ops->unmap(ops->mm_idp, addr, end - addr);
+	if (!ops->anchor)
+		return;
+	anchors_forget(ops->mm, addr, end);
+	if (!*ret)
+		um_tlb_anchor_hole(ops, addr, end);
+}
+
 static int kern_map(struct mm_id *mm_idp,
 		    unsigned long virt, unsigned long len, int prot,
 		    int phys_fd, unsigned long long offset)
@@ -162,10 +202,7 @@ static inline int update_pmd_range(pud_t *pud, unsigned long addr,
 		next = pmd_addr_end(addr, end);
 		if (!pmd_present(*pmd)) {
 			if (pmd_needsync(*pmd)) {
-				ret = ops->unmap(ops->mm_idp, addr,
-						 next - addr);
-				if (ops->anchor)
-					anchors_forget(ops->mm, addr, next);
+				um_tlb_unmap_hole(ops, addr, next, &ret);
 				pmd_mkuptodate(*pmd);
 			}
 		}
@@ -187,10 +224,7 @@ static inline int update_pud_range(p4d_t *p4d, unsigned long addr,
 		next = pud_addr_end(addr, end);
 		if (!pud_present(*pud)) {
 			if (pud_needsync(*pud)) {
-				ret = ops->unmap(ops->mm_idp, addr,
-						 next - addr);
-				if (ops->anchor)
-					anchors_forget(ops->mm, addr, next);
+				um_tlb_unmap_hole(ops, addr, next, &ret);
 				pud_mkuptodate(*pud);
 			}
 		}
@@ -212,10 +246,7 @@ static inline int update_p4d_range(pgd_t *pgd, unsigned long addr,
 		next = p4d_addr_end(addr, end);
 		if (!p4d_present(*p4d)) {
 			if (p4d_needsync(*p4d)) {
-				ret = ops->unmap(ops->mm_idp, addr,
-						 next - addr);
-				if (ops->anchor)
-					anchors_forget(ops->mm, addr, next);
+				um_tlb_unmap_hole(ops, addr, next, &ret);
 				p4d_mkuptodate(*p4d);
 			}
 		} else
@@ -268,10 +299,7 @@ int um_tlb_sync(struct mm_struct *mm)
