 		 int (*op)(unsigned long addr, int len, void *arg), void *arg)
 {
@@ -68,6 +96,15 @@ static int do_op_one_page(unsigned long addr, int len, int is_write,
 	pte_t *pte;
 	int n;
 
+	/* Host device memory has no pages, the copy goes to the host mapping */
+	if (current->mm && !list_empty(&current->mm->context.hostmaps)) {
+		pte = virt_to_pte(current->mm, addr);
+		if ((!pte || !pte_present(*pte)) &&
+		    um_hostmap_op(current->mm, addr, len, is_write, op, arg,
+				  &n))
+			return n;
+	}
