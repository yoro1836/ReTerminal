+};
+
+struct mm_struct;
+void um_hostmap_add(struct mm_struct *mm, struct um_hostmap *m);
+void um_hostmap_del(struct mm_struct *mm, struct um_hostmap *m);
+int um_hostmap_fault(struct mm_struct *mm, unsigned long addr);
+void um_hostmap_destroy(struct mm_struct *mm);
+bool um_hostmap_op(struct mm_struct *mm, unsigned long addr, int len,
+		   int is_write,
+		   int (*op)(unsigned long addr, int len, void *arg),
+		   void *arg, int *ret);
+int um_user_prefault(unsigned long addr, unsigned long len, int is_write);
+
 #define INIT_MM_CONTEXT(mm)						\
 	.context = {							\
 		.turnstile = __MUTEX_INITIALIZER(mm.context.turnstile),	\
 		.sync_tlb_lock = __SPIN_LOCK_INITIALIZER(mm.context.sync_tlb_lock), \
+		.hostmaps = LIST_HEAD_INIT(mm.context.hostmaps),	\
