+	to->syscall_data_len = 0;
+	to->syscall_fd_num = 0;
+	to->cloned = 0;
+	to->sock = sv[1];
+	to->pid = from->pid;
+	to->tid = tid;
+	((struct stub_data *)to->stack)->self_tid = tid;
+	/* Its first report is the SIGTRAP of stub_thread_child() */
+	to->boot_pending = 2;
+	return 0;
+
+fail:
+	close(sv[0]);
+	close(sv[1]);
+	return -1;
