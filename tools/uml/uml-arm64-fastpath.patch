 }
 
 void __init prefill_possible_map(void)
diff --git a/arch/um/os-Linux/skas/process.c b/arch/um/os-Linux/skas/process.c
index 7234568b1943..26197dd3fc9b 100644
--- a/arch/um/os-Linux/skas/process.c
+++ b/arch/um/os-Linux/skas/process.c
@@ -457,6 +457,40 @@ static int fastest_cpu(unsigned long m)
 	return best;
 }
 
+/*
+ * The CPUs in m at least half as strong as the best of them. Guest code and
+ * the host mmap/munmap a stub runs are several times slower on little cores
+ * (S24: host munmap 13us on A520, 3us on A720, 2us on X4).
+ */
+static unsigned long fast_cpus(unsigned long m)
+{
+	unsigned long fast = 0;
+	int best = cpu_capacity(fastest_cpu(m));
+	int c;
+
+	for (c = 0; c < 64 && best > 0; c++)
+		if ((m >> c & 1) && cpu_capacity(c) * 2 > best)
+			fast |= 1UL << c;
+	return fast ? fast : m;
+}
+
+/*
+ * stub_pin=1 with SMP: the whole kernel (vCPU threads, stubs) stays on the
+ * fast CPUs of the affinity it was started with. Called before any CPU
+ * thread or stub exists, so all of them inherit it.
+ */
+void os_pin_fast_cpus(void)
+{
+	unsigned long m = 0, f;
+
+	if (!stub_pin || uml_ncpus <= 1 ||
+	    syscall(__NR_sched_getaffinity, 0, sizeof(m), &m) < 0)
+		return;
+	f = fast_cpus(m);
+	if (f != m && syscall(__NR_sched_setaffinity, 0, sizeof(f), &f) == 0)
+		os_info("stub_pin: SMP on fast CPUs %lx\n", f);
+}
+
 static unsigned long stub_pin_mask(void)
 {
 	static int done;
@@ -477,22 +511,8 @@ static unsigned long stub_pin_mask(void)
 	if (syscall(__NR_sched_setaffinity, 0, sizeof(k), &k) < 0)
 		return 0;
 	stub_cpumask = m & ~k;
-	/*
-	 * Keep stubs (guest code and the host mmap/munmap the stub runs) off
-	 * the little cores: there the same host munmap takes 13us vs 2-3us.
-	 * Only CPUs at least half as strong as the best one left are used.
-	 */
-	{
-		unsigned long fast = 0;
-		int best = cpu_capacity(fastest_cpu(stub_cpumask));
-		int c;
-
-		for (c = 0; c < 64 && best > 0; c++)
-			if ((stub_cpumask >> c & 1) && cpu_capacity(c) * 2 > best)
-				fast |= 1UL << c;
-		if (fast)
-			stub_cpumask = fast;
-	}
+	/* Stubs off the little cores too, see fast_cpus(). */
+	stub_cpumask = fast_cpus(stub_cpumask);
 	printk(UM_KERN_INFO "stub_pin: kernel on CPU %d, stubs on %lx\n",
 	       cpu, stub_cpumask);
 	return stub_cpumask;
