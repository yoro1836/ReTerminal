+/*
+ * Hand a new mm to a spare stub. Returns its pid, or <0 to start one from
+ * scratch instead.
+ */
+static int zygote_spawn(struct stub_data *stub_data, int stub_sock)
+{
+	struct stub_init_data init_data;
+	struct iovec iov = { .iov_base = &init_data, .iov_len = sizeof(init_data) };
+	union {
+		char buf[CMSG_SPACE(sizeof(int))];
+		struct cmsghdr align;
+	} ctrl;
+	struct msghdr mh = {
+		.msg_iov = &iov,
+		.msg_iovlen = 1,
+		.msg_control = ctrl.buf,
+		.msg_controllen = sizeof(ctrl.buf),
+	};
+	struct cmsghdr *cm;
+	int pid, sock, n, i;
+
+	if (!using_seccomp || !zygote_on || zygote_state < 0)
+		return -1;
+	if (!zygote_state)
+		zygote_start(stub_data);
+	if (zygote_state < 0)
+		return -1;
+
+	/* Collect what is ready; block only if nothing is. */
+	while (spare_asked && spare_n < ZYGOTE_SPARES &&
+	       zygote_recv(0) > 0)
+		;
+	if (!spare_n && (!spare_asked || zygote_recv(1) <= 0))
+		return -1;
+
+	pid = spare_pid[0];
+	sock = spare_sock[0];
+	spare_n--;
+	for (i = 0; i < spare_n; i++) {
+		spare_pid[i] = spare_pid[i + 1];
+		spare_sock[i] = spare_sock[i + 1];
+	}
+	zygote_ask();	/* a replacement, made while this one runs */
+
+	stub_fill_init_data(&init_data, stub_data);
+	memset(&ctrl, 0, sizeof(ctrl));
+	cm = CMSG_FIRSTHDR(&mh);
+	cm->cmsg_level = SOL_SOCKET;
+	cm->cmsg_type = SCM_RIGHTS;
+	cm->cmsg_len = CMSG_LEN(sizeof(int));
+	memcpy(CMSG_DATA(cm), &stub_sock, sizeof(int));
+
+	/* The stub's end is used non-blocking; the flag lives in the file. */
+	fcntl(stub_sock, F_SETFL, fcntl(stub_sock, F_GETFL) | O_NONBLOCK);
+
+	CATCH_EINTR(n = sendmsg(sock, &mh, MSG_NOSIGNAL));
+	close(sock);
+	if (n != sizeof(init_data)) {
+		/* That spare died; start this stub from scratch. */
+		kill(pid, SIGKILL);
+		return -1;
+	}
+	return pid;
+}
