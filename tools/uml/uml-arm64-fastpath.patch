+			stub_syscall3(__NR_dup3, sv[0], 100, 0);
+			stub_syscall3(__NR_dup3, init_data->stub_code_fd, 101, 0);
+			stub_syscall3(__NR_dup3, 101, 3, 0);
+			stub_syscall3(__NR_dup3, 100, 4, 0);
+			stub_syscall3(__NR_close_range, 0, 2, 0);
