+		      MAP_NORESERVE | MAP_STACK)) !=
+	    (MAP_PRIVATE | MAP_ANONYMOUS))
+		return;
+	if ((prot & (PROT_READ | PROT_WRITE)) != (PROT_READ | PROT_WRITE))
+		return;
+	mm_populate(addr, PAGE_SIZE);
+}
+
 static int __init um_prefault_setup(char *str)
 {
