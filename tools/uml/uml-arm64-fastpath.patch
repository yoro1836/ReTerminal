+				       VM_HUGETLB)) ||
+	    !(vma->vm_flags & VM_WRITE) || userfaultfd_armed(vma))
+		return true;
+
+	address &= PAGE_MASK;
+	start = address & PMD_MASK;
+	end = min(start + PMD_SIZE, vma->vm_end);
+	start = max(start, vma->vm_start);
+	if (address - start > span)
+		start = address - span;
+	if (end - address > span + PAGE_SIZE)
+		end = address + span + PAGE_SIZE;
+
+	pmd = pmd_off(mm, address);
+	if (!pmd_present(*pmd))
