+
+static unsigned long um_cntvct_freq(void)
+{
+	unsigned long v;
+
+	asm volatile("mrs %0, cntfrq_el0" : "=r" (v));
+	return v;
+}
+
+static u64 um_cntvct_read(struct clocksource *cs)
+{
+	u64 v;
+
+	asm volatile("isb\n\tmrs %0, cntvct_el0" : "=r" (v));
+	return v;
+}
+
+static struct clocksource um_cntvct = {
+	.name	= "arch_sys_counter",
+	.rating	= 400,
+	.read	= um_cntvct_read,
+	.mask	= CLOCKSOURCE_MASK(56),
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+};
