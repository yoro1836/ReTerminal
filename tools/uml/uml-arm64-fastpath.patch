+static __thread unsigned int ipi_pending;
 
-void os_local_ipi_enable(void)
+int os_ipi_pending(void)
 {
-	__local_ipi_set(1);
+	return __atomic_load_n(&ipi_pending, __ATOMIC_RELAXED) != 0;
 }
 
-void os_local_ipi_disable(void)
+void os_run_pending_ipis(void)
 {
-	__local_ipi_set(0);
+	unsigned int v = __atomic_exchange_n(&ipi_pending, 0, __ATOMIC_RELAXED);
+	int i;
+
+	for (i = 0; v; i++, v >>= 1)
