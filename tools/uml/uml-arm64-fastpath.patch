 arch/um/drivers/hostdev.h      |  19 ++
 arch/um/drivers/hostdev_kern.c | 497 +++++++++++++++++++++++++++++++--
 arch/um/drivers/hostdev_user.c | 125 +++++++++
 4 files changed, 613 insertions(+), 32 deletions(-)
 create mode 100644 arch/um/drivers/hostdev.h
 create mode 100644 arch/um/drivers/hostdev_user.c

