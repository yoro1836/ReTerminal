+	/* Collect what is ready; block only if nothing is. */
+	while (spare_asked && spare_n < ZYGOTE_SPARES &&
+	       zygote_recv(0) > 0)
+		;
+	if (!spare_n && (!spare_asked || zygote_recv(1) <= 0))
+		return -1;
