diff --git a/arch/um/drivers/hostdev_kern.c b/arch/um/drivers/hostdev_kern.c
new file mode 100644
index 000000000000..3fb9cf0c8828
--- /dev/null
+++ b/arch/um/drivers/hostdev_kern.c
@@ -0,0 +1,1144 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Host character device passthrough.
+ *
+ *   hostdev=<host path>,<guest name>,<major>:<minor>[,drm][,direct]
+ *
+ * makes a guest character device whose open/ioctl/mmap go to the host
+ * device. An ioctl runs inside the calling process's stub, whose address
+ * space is the guest process's, so the host follows guest pointers itself;
+ * the pages behind them are faulted in first, because the host returns
+ * EFAULT where the guest would fault. The argument struct is bounced through
+ * the stub data page. mmap maps the host fd straight into the stub (struct
+ * um_hostmap): no guest pages.
+ *
+ * Only pointers named in a table can be faulted in. "drm" selects the table
+ * for DRM render nodes with the amdgpu uapi (Samsung sgpu included) and
+ * makes sysfs look like a platform DRM device to libdrm.
+ * "direct" passes the guest pointer instead of bouncing (testing).
+ *
+ * Host fds the device hands out (dma-bufs, sync files) become guest "hostfd"
+ * files; ioctls taking one get the host fd back. To give them to a host
+ * process there is
+ *
+ *   hostdev=<host unix socket path>,<guest name>,<major>:<minor>,sock
+ *
+ * a character device that is one connection to that socket per open:
+ * read/write/poll carry the stream, HOSTSOCK_SEND sends data with hostfd
+ * files attached as SCM_RIGHTS (a guest daemon bridges an X11 socket to it).
+ * /dev/hostshm gives a 4 byte host memfd per open, as a hostfd file, for
+ * memory shared with such a process (xshmfence).
+ */
+
+#include <linux/anon_inodes.h>
+#include <linux/cdev.h>
+#include <linux/file.h>
+#include <linux/miscdevice.h>
+#include <linux/poll.h>
+#include <linux/wait.h>
+#include <uapi/linux/dma-buf.h>
+#include <uapi/linux/sync_file.h>
+#include <irq_kern.h>
+#include "hostdev.h"
+#include <linux/device.h>
+#include <linux/delay.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/ktime.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/xarray.h>
+#include <uapi/drm/drm.h>
+#include <uapi/drm/amdgpu_drm.h>
+
+#include <asm/mmu.h>
+#include <asm/tlbflush.h>
+#include <init.h>
+#include <mm_id.h>
+#include <os.h>
+
+#define HOSTDEV_MAX	4
+#define HOSTDEV_DRM	1
+#define HOSTDEV_DIRECT	2
+#define HOSTDEV_SOCK	4
+
+/* HOSTSOCK_SEND: write @len bytes at @data with @nfds hostfd files attached */
+struct hostsock_send {
+	__u64 data;
+	__u32 len;
+	__u32 nfds;
+	__s32 fds[HOSTDEV_MAX_FDS];
+};
+#define HOSTSOCK_SEND	_IOW('H', 1, struct hostsock_send)
+
+/* A wait holds the stub (and a vCPU), so it is done in slices of this. */
+#define HOSTDEV_WAIT_SLICE_NS	250000
+
+struct hostdev {
+	char *host;
+	char *name;
+	dev_t devt;
+	unsigned int flags;
+	struct cdev cdev;
+};
+
+static struct hostdev hostdevs[HOSTDEV_MAX];
+/* hostdev_debug=1: log failed ioctls with their argument, 2: all */
+static int hostdev_debug;
+core_param(hostdev_debug, hostdev_debug, int, 0644);
+static int hostdev_count;
+
+/* The host fd comes first in every file type um_hostfd_of() knows */
+struct hostdev_file {
+	int fd;
+	struct hostdev *dev;
+	/* DRM: mmap cookie -> host fake offset, see hostdev_drm_post() */
+	struct xarray offsets;
+	u32 next_offset;
+	struct mutex lock;
+};
+
+struct hostfd {
+	int fd;
+};
+
+static const struct file_operations hostdev_fops, hostfd_fops, hostshm_fops;
+
+/* The host fd behind a guest file, or -1 */
+static int um_hostfd_of(struct file *file)
+{
+	if (file->f_op != &hostdev_fops && file->f_op != &hostfd_fops &&
+	    file->f_op != &hostshm_fops)
+		return -1;
+	return *(int *)file->private_data;
+}
+
+static int um_hostfd_of_fd(int guest_fd, struct file **filep)
+{
+	struct file *file = fget(guest_fd);
+	int fd;
+
+	if (!file)
+		return -EBADF;
+	fd = um_hostfd_of(file);
+	if (fd < 0) {
+		fput(file);
+		return -EINVAL;
+	}
+	*filep = file;
+	return fd;
+}
+
+/* Wrap a host fd the kernel process owns into a guest fd; closes it on error */
+static int hostfd_install(int host_fd)
+{
+	struct hostfd *h = kzalloc(sizeof(*h), GFP_KERNEL);
+	int fd;
+
+	if (!h) {
+		os_close_file(host_fd);
+		return -ENOMEM;
+	}
+	h->fd = host_fd;
+	fd = anon_inode_getfd("hostfd", &hostfd_fops, h, O_RDWR | O_CLOEXEC);
+	if (fd < 0) {
+		os_close_file(host_fd);
+		kfree(h);
+	}
+	return fd;
+}
+
+/* An ioctl with a host fd going @in or coming out at @fdp, no pointers */
+static long hostfd_ioctl_fd(int host_fd, unsigned int cmd, void *buf,
+			    __s32 *fdp, bool in, bool out)
+{
+	struct file *file = NULL;
+	long ret;
+
+	if (in) {
+		int fd = um_hostfd_of_fd(*fdp, &file);
+
+		if (fd < 0)
+			return fd;
+		*fdp = fd;
+	}
+	ret = hostdev_user_ioctl(host_fd, cmd, buf);
+	if (file)
+		fput(file);
+	if (!ret && out) {
+		int fd = hostfd_install(*fdp);
+
+		if (fd < 0)
+			return fd;
+		*fdp = fd;
+	}
+	return ret;
+}
+
+struct hostdev_range {
+	unsigned long addr, len;
+	int write;
+};
+
+struct hostdev_req {
+	struct hostdev_range *r;
+	int n, cap;
+	struct hostdev_range inl[8];
+	/* sliced wait: byte offset of the absolute timeout in the argument */
+	int wait_off;
+	bool wait_s64, wait_etime;
+	/* done in hostdev_drm_pre() by the kernel process, with this result */
+	bool done;
+};
+
+static int req_add(struct hostdev_req *q, u64 addr, u64 len, int write)
+{
+	if (!len)
+		return 0;
+	if (addr + len < addr || addr + len > TASK_SIZE)
+		return -EFAULT;
+	if (q->n == q->cap) {
+		int cap = q->cap * 4;
+		struct hostdev_range *r = kmalloc_array(cap, sizeof(*r),
+							GFP_KERNEL);
+
+		if (!r)
+			return -ENOMEM;
+		memcpy(r, q->r, q->n * sizeof(*r));
+		if (q->r != q->inl)
+			kfree(q->r);
+		q->r = r;
+		q->cap = cap;
+	}
+	q->r[q->n++] = (struct hostdev_range){ addr, len, write };
+	return 0;
+}
+
+/*
+ * DRM core + amdgpu: the user memory each ioctl points to, and the calls
+ * that cannot work through this device. @p is the kernel copy of the
+ * argument and may be adjusted.
+ */
+static int hostdev_drm_pre(struct hostdev_file *hf, unsigned int cmd, void *p,
+			   struct hostdev_req *q)
+{
+	unsigned int nr = _IOC_NR(cmd), size = _IOC_SIZE(cmd);
+	int err = 0;
+
+	if (_IOC_TYPE(cmd) != DRM_IOCTL_BASE)
+		return 0;
+
+#define NEED(type) do { if (size < sizeof(type)) return -EINVAL; } while (0)
+	switch (nr) {
+	case _IOC_NR(DRM_IOCTL_VERSION): {
+		struct drm_version *v = p;
+
+		NEED(*v);
+		err = req_add(q, (unsigned long)v->name, v->name_len, 1) ?:
+		      req_add(q, (unsigned long)v->date, v->date_len, 1) ?:
+		      req_add(q, (unsigned long)v->desc, v->desc_len, 1);
+		break;
+	}
+	case _IOC_NR(DRM_IOCTL_GET_UNIQUE): {
+		struct drm_unique *u = p;
+
+		NEED(*u);
+		err = req_add(q, (unsigned long)u->unique, u->unique_len, 1);
+		break;
+	}
+	/*
+	 * Host fds: these run in the kernel process, which is where the fd
+	 * must end up (the device fd is the same open file there).
+	 */
+	case _IOC_NR(DRM_IOCTL_PRIME_HANDLE_TO_FD):
+	case _IOC_NR(DRM_IOCTL_PRIME_FD_TO_HANDLE): {
+		struct drm_prime_handle *h = p;
+		bool in = nr == _IOC_NR(DRM_IOCTL_PRIME_FD_TO_HANDLE);
+
+		NEED(*h);
+		q->done = true;
+		return hostfd_ioctl_fd(hf->fd, cmd, p, &h->fd, in, !in);
+	}
+	case _IOC_NR(DRM_IOCTL_SYNCOBJ_HANDLE_TO_FD):
+	case _IOC_NR(DRM_IOCTL_SYNCOBJ_FD_TO_HANDLE): {
+		struct drm_syncobj_handle *h = p;
+		bool in = nr == _IOC_NR(DRM_IOCTL_SYNCOBJ_FD_TO_HANDLE);
+
+		if (size < offsetof(struct drm_syncobj_handle, point))
+			return -EINVAL;
+		q->done = true;
+		return hostfd_ioctl_fd(hf->fd, cmd, p, &h->fd, in, !in);
+	}
+	case _IOC_NR(DRM_IOCTL_SYNCOBJ_EVENTFD):
+		return -EOPNOTSUPP;
+	case _IOC_NR(DRM_IOCTL_SYNCOBJ_WAIT): {
+		struct drm_syncobj_wait *w = p;
+
+		NEED(struct drm_syncobj_array);
+		if (size < offsetof(struct drm_syncobj_wait, deadline_nsec))
+			return -EINVAL;
+		err = req_add(q, w->handles, (u64)w->count_handles * 4, 0);
+		q->wait_off = offsetof(struct drm_syncobj_wait, timeout_nsec);
+		q->wait_s64 = q->wait_etime = true;
+		break;
+	}
+	case _IOC_NR(DRM_IOCTL_SYNCOBJ_TIMELINE_WAIT): {
+		struct drm_syncobj_timeline_wait *w = p;
+
+		if (size < offsetof(struct drm_syncobj_timeline_wait,
+				    deadline_nsec))
+			return -EINVAL;
+		err = req_add(q, w->handles, (u64)w->count_handles * 4, 0) ?:
+		      req_add(q, w->points, (u64)w->count_handles * 8, 0);
+		q->wait_off = offsetof(struct drm_syncobj_timeline_wait,
+				       timeout_nsec);
+		q->wait_s64 = q->wait_etime = true;
+		break;
+	}
+	case _IOC_NR(DRM_IOCTL_SYNCOBJ_RESET):
+	case _IOC_NR(DRM_IOCTL_SYNCOBJ_SIGNAL): {
+		struct drm_syncobj_array *a = p;
+
+		NEED(*a);
+		err = req_add(q, a->handles, (u64)a->count_handles * 4, 0);
+		break;
+	}
+	case _IOC_NR(DRM_IOCTL_SYNCOBJ_QUERY):
+	case _IOC_NR(DRM_IOCTL_SYNCOBJ_TIMELINE_SIGNAL): {
+		struct drm_syncobj_timeline_array *a = p;
+
+		NEED(*a);
+		err = req_add(q, a->handles, (u64)a->count_handles * 4, 0) ?:
+		      req_add(q, a->points, (u64)a->count_handles * 8,
+			      nr == _IOC_NR(DRM_IOCTL_SYNCOBJ_QUERY));
+		break;
+	}
+
+	case DRM_COMMAND_BASE + DRM_AMDGPU_GEM_CREATE: {
+		union drm_amdgpu_gem_create *c = p;
+
+		NEED(*c);
+		/* The guest maps whole guest pages, the host checks the size */
+		c->in.bo_size = PAGE_ALIGN(c->in.bo_size);
+		break;
+	}
+	case DRM_COMMAND_BASE + DRM_AMDGPU_BO_LIST: {
+		union drm_amdgpu_bo_list *l = p;
+
+		NEED(*l);
+		if (l->in.operation != AMDGPU_BO_LIST_OP_DESTROY)
+			err = req_add(q, l->in.bo_info_ptr,
+				      (u64)l->in.bo_number *
+				      l->in.bo_info_size, 0);
+		break;
+	}
+	case DRM_COMMAND_BASE + DRM_AMDGPU_CS: {
+		union drm_amdgpu_cs *cs = p;
+		u64 __user *ptrs = u64_to_user_ptr(cs->in.chunks);
+		u32 i, n = cs->in.num_chunks;
+
+		NEED(*cs);
+		if (n > 1024)
+			return -E2BIG;
+		err = req_add(q, cs->in.chunks, (u64)n * 8, 0);
+		for (i = 0; i < n && !err; i++) {
+			struct drm_amdgpu_cs_chunk ch;
+			u64 ptr;
+
+			if (get_user(ptr, ptrs + i) ||
+			    copy_from_user(&ch, u64_to_user_ptr(ptr),
+					   sizeof(ch)))
+				return -EFAULT;
+			err = req_add(q, ptr, sizeof(ch), 0) ?:
+			      req_add(q, ch.chunk_data,
+				      (u64)ch.length_dw * 4, 0);
+		}
+		break;
+	}
+	case DRM_COMMAND_BASE + DRM_AMDGPU_INFO: {
+		struct drm_amdgpu_info *i = p;
+
+		if (size < 16)
+			return -EINVAL;
+		err = req_add(q, i->return_pointer, i->return_size, 1);
+		break;
+	}
+	case DRM_COMMAND_BASE + DRM_AMDGPU_GEM_WAIT_IDLE:
+		NEED(union drm_amdgpu_gem_wait_idle);
+		q->wait_off = offsetof(struct drm_amdgpu_gem_wait_idle_in,
+				       timeout);
+		break;
+	case DRM_COMMAND_BASE + DRM_AMDGPU_WAIT_CS:
+		NEED(union drm_amdgpu_wait_cs);
+		q->wait_off = offsetof(struct drm_amdgpu_wait_cs_in, timeout);
+		break;
+	case DRM_COMMAND_BASE + DRM_AMDGPU_WAIT_FENCES: {
+		union drm_amdgpu_wait_fences *w = p;
+
+		NEED(*w);
+		err = req_add(q, w->in.fences, (u64)w->in.fence_count *
+			      sizeof(struct drm_amdgpu_fence), 0);
+		q->wait_off = offsetof(struct drm_amdgpu_wait_fences_in,
+				       timeout_ns);
+		break;
+	}
+	case DRM_COMMAND_BASE + DRM_AMDGPU_GEM_OP: {
+		struct drm_amdgpu_gem_op *o = p;
+
+		if (size < 16)
+			return -EINVAL;
+		if (o->op == AMDGPU_GEM_OP_GET_GEM_CREATE_INFO)
+			err = req_add(q, o->value,
+				      sizeof(struct drm_amdgpu_gem_create_in),
+				      1);
+		else if (o->op != AMDGPU_GEM_OP_SET_PLACEMENT)
+			return -EOPNOTSUPP;
+		break;
+	}
+	case DRM_COMMAND_BASE + DRM_AMDGPU_FENCE_TO_HANDLE: {
+		union drm_amdgpu_fence_to_handle *f = p;
+
+		NEED(*f);
+		if (f->in.what != AMDGPU_FENCE_TO_HANDLE_GET_SYNCOBJ) {
+			q->done = true;
+			return hostfd_ioctl_fd(hf->fd, cmd, p,
+					       (__s32 *)&f->out.handle, false,
+					       true);
+		}
+		break;
+	}
+	/* Pins guest RAM, or takes a host fd */
+	case DRM_COMMAND_BASE + DRM_AMDGPU_GEM_USERPTR:
+	case DRM_COMMAND_BASE + DRM_AMDGPU_SCHED:
+		return -EOPNOTSUPP;
+	}
+#undef NEED
+	return err;
+}
+
+/*
+ * GEM_MMAP returns a fake offset in host pages, which need not be a multiple
+ * of the (bigger) guest page. Hand out one of our own instead: cookie n is
+ * guest offsets [(n + 1) << 32, (n + 2) << 32).
+ */
+static int hostdev_drm_post(struct hostdev_file *hf, unsigned int cmd, void *p)
+{
+	union drm_amdgpu_gem_mmap *m = p;
+	unsigned long idx;
+	void *entry;
+	u32 id;
+	int err;
+
+	if (_IOC_TYPE(cmd) != DRM_IOCTL_BASE)
+		return 0;
+
+	/*
+	 * Userspace rounds what it maps to its own page size, so it must see
+	 * the alignments a host with the guest's page size would report.
+	 */
+	if (_IOC_NR(cmd) == DRM_COMMAND_BASE + DRM_AMDGPU_INFO) {
+		static const size_t fields[] = {
+			offsetof(struct drm_amdgpu_info_device,
+				 virtual_address_alignment),
+			offsetof(struct drm_amdgpu_info_device, gart_page_size),
+		};
+		struct drm_amdgpu_info *info = p;
+		int i;
+
+		if (info->query != AMDGPU_INFO_DEV_INFO)
+			return 0;
+		for (i = 0; i < ARRAY_SIZE(fields); i++) {
+			u32 __user *f = u64_to_user_ptr(info->return_pointer +
+							fields[i]);
+			u32 v;
+
+			if (fields[i] + 4 > info->return_size)
+				continue;
+			if (get_user(v, f) || (v < PAGE_SIZE &&
+					       put_user((u32)PAGE_SIZE, f)))
+				return -EFAULT;
+		}
+		return 0;
+	}
+
+	if (_IOC_NR(cmd) != DRM_COMMAND_BASE + DRM_AMDGPU_GEM_MMAP)
+		return 0;
+	if (m->out.addr_ptr & 0xfff || m->out.addr_ptr >> 44)
+		return -EIO;
+
+	guard(mutex)(&hf->lock);
+	xa_for_each(&hf->offsets, idx, entry) {
+		if (xa_to_value(entry) == m->out.addr_ptr >> 12) {
+			m->out.addr_ptr = (idx + 1) << 32;
+			return 0;
+		}
+	}
+	err = xa_alloc(&hf->offsets, &id, xa_mk_value(m->out.addr_ptr >> 12),
+		       XA_LIMIT(0, 0x3fffffff), GFP_KERNEL);
+	if (err)
+		return err;
+	m->out.addr_ptr = ((u64)id + 1) << 32;
+	return 0;
+}
+
+/* One trip to the stub. EFAULT can mean reclaim got in between: retry. */
+static long hostdev_exec(struct hostdev_file *hf, struct hostdev_req *q,
+			 unsigned int cmd, unsigned long arg, void *buf,
+			 unsigned int size)
+{
+	struct mm_struct *mm = current->mm;
+	struct mm_id *id = &mm->context.id;
+	int tries, i;
+	long ret;
+
+	for (tries = 0; ; tries++) {
+		enter_turnstile(id);
+		ret = 0;
+		for (i = 0; i < q->n && !ret; i++)
+			ret = um_user_prefault(q->r[i].addr, q->r[i].len,
+					       q->r[i].write);
+		if (!ret) {
+			um_tlb_sync(mm);
+			ret = stub_host_ioctl(id, hf->fd, cmd, arg, buf, size);
+		}
+		exit_turnstile(id);
+
+		if (ret == -EINTR && !signal_pending(current) && tries < 100)
+			continue;
+		if (ret != -EFAULT || tries >= 3)
+			return ret;
+	}
+}
+
+static long hostdev_wait(struct hostdev_file *hf, struct hostdev_req *q,
+			 unsigned int cmd, void *buf, unsigned int size)
+{
+	u64 *field = buf + q->wait_off, raw = *field;
+	bool infinite = !q->wait_s64 && raw > S64_MAX;
+	s64 deadline = raw;
+	void *saved;
+	long ret;
+
+	saved = kmemdup(buf, size, GFP_KERNEL);
+	if (!saved)
+		return -ENOMEM;
+
+	for (;;) {
+		s64 rem = infinite ? S64_MAX : deadline - (s64)ktime_get_ns();
+		s64 slice = clamp_t(s64, rem, 0, HOSTDEV_WAIT_SLICE_NS);
+		bool busy;
+
+		memcpy(buf, saved, size);
+		/* The host's clock is not the guest's */
+		*field = slice ? os_nsecs() + slice : 0;
+
+		ret = hostdev_exec(hf, q, cmd, 0, buf, size);
+		busy = q->wait_etime ? ret == -ETIME :
+				       ret == 0 && *(u32 *)buf != 0;
+		if (!busy || rem <= slice)
+			break;
+		if (signal_pending(current)) {
+			ret = -EINTR;
+			break;
+		}
+		cond_resched();
+	}
+	kfree(saved);
+	return ret;
+}
+
+static long hostdev_ioctl(struct file *file, unsigned int cmd,
+			  unsigned long arg)
+{
+	struct hostdev_file *hf = file->private_data;
+	unsigned int size = _IOC_SIZE(cmd), dir = _IOC_DIR(cmd);
+	struct hostdev_req q = { .wait_off = -1 };
+	void __user *uarg = (void __user *)arg;
+	void *buf = NULL, *dbg = NULL;
+	long ret;
+
+	if (!current->mm)
+		return -EINVAL;
+	q.r = q.inl;
+	q.cap = ARRAY_SIZE(q.inl);
+
+	if (hf->dev->flags & HOSTDEV_DIRECT) {
+		ret = req_add(&q, arg, size ?: sizeof(long), 1) ?:
+		      hostdev_exec(hf, &q, cmd, arg, NULL, 0);
+		goto out;
+	}
+
+	/* Not an _IOC() encoded command: the argument is a plain value */
+	if (!size || dir == _IOC_NONE) {
+		ret = hostdev_exec(hf, &q, cmd, arg, NULL, 0);
+		goto out;
+	}
+
+	if (size > stub_host_ioctl_max())
+		return -ENOTTY;
+	buf = kzalloc(size, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	if ((dir & _IOC_WRITE) && copy_from_user(buf, uarg, size)) {
+		ret = -EFAULT;
+		goto out;
+	}
+
+	if (hostdev_debug)
+		dbg = kmemdup(buf, size, GFP_KERNEL);
+
+	if (hf->dev->flags & HOSTDEV_DRM) {
+		ret = hostdev_drm_pre(hf, cmd, buf, &q);
+		if (ret && !q.done)
+			goto out;
+	}
+
+	if (q.done)
+		;
+	else if (q.wait_off >= 0)
+		ret = hostdev_wait(hf, &q, cmd, buf, size);
+	else
+		ret = hostdev_exec(hf, &q, cmd, 0, buf, size);
+
+	if (!ret && (hf->dev->flags & HOSTDEV_DRM))
+		ret = hostdev_drm_post(hf, cmd, buf);
+	if ((dir & _IOC_READ) && copy_to_user(uarg, buf, size))
+		ret = -EFAULT;
+out:
+	if (dbg && (ret < 0 || hostdev_debug > 1)) {
+		pr_info("hostdev: %s[%d] ioctl %08x = %ld\n", current->comm,
+			current->pid, cmd, ret);
+		print_hex_dump(KERN_INFO, "  in:  ", DUMP_PREFIX_OFFSET, 16,
+			       8, dbg, size, false);
+		if (hostdev_debug > 1)
+			print_hex_dump(KERN_INFO, "  out: ", DUMP_PREFIX_OFFSET,
+				       16, 8, buf, size, false);
+	}
+	kfree(dbg);
+	if (q.r != q.inl)
+		kfree(q.r);
+	kfree(buf);
+	return ret;
+}
+
+static void hostdev_vma_close(struct vm_area_struct *vma)
+{
+	um_hostmap_del(vma->vm_mm, vma->vm_private_data);
+}
+
+static int hostdev_vma_split(struct vm_area_struct *vma, unsigned long addr)
+{
+	return -EINVAL;
+}
+
+static vm_fault_t hostdev_vma_fault(struct vm_fault *vmf)
+{
+	return VM_FAULT_SIGBUS;
+}
+
+static const struct vm_operations_struct hostdev_vm_ops = {
+	.close = hostdev_vma_close,
+	.may_split = hostdev_vma_split,
+	.fault = hostdev_vma_fault,
+};
+
+static int hostdev_map(int fd, u64 off, struct vm_area_struct *vma)
+{
+	unsigned long len = vma->vm_end - vma->vm_start;
+	struct um_hostmap *m;
+	int prot = 0, err;
+
+	if (!(vma->vm_flags & VM_SHARED))
+		return -EINVAL;
+
+	if (vma->vm_flags & VM_READ)
+		prot |= UM_PROT_READ;
+	if (vma->vm_flags & VM_WRITE)
+		prot |= UM_PROT_WRITE;
+
+	err = os_mmap_probe(fd, off, len, prot);
+	if (err)
+		return err;
+
+	m = kzalloc(sizeof(*m), GFP_KERNEL);
+	if (!m)
+		return -ENOMEM;
+	m->start = vma->vm_start;
+	m->end = vma->vm_end;
+	m->offset = off;
+	m->fd = fd;
+	m->prot = prot;
+
+	vm_flags_set(vma, VM_IO | VM_PFNMAP | VM_DONTCOPY | VM_DONTEXPAND |
+			  VM_DONTDUMP);
+	vm_flags_clear(vma, VM_MAYEXEC);
+	vma->vm_ops = &hostdev_vm_ops;
+	vma->vm_private_data = m;
+	um_hostmap_add(vma->vm_mm, m);
+	return 0;
+}
+
+static int hostdev_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct hostdev_file *hf = file->private_data;
+	u64 off = (u64)vma->vm_pgoff << PAGE_SHIFT;
+
+	if (hf->dev->flags & HOSTDEV_DRM) {
+		void *entry;
+
+		if (off >> 32 == 0)
+			return -EINVAL;
+		entry = xa_load(&hf->offsets, (off >> 32) - 1);
+		if (!entry)
+			return -EINVAL;
+		off = ((u64)xa_to_value(entry) << 12) + (u32)off;
+	}
+	return hostdev_map(hf->fd, off, vma);
+}
+
+/* hostfd files: a host fd of some other kind (dma-buf, sync file, memfd) */
+
+static int hostfd_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct hostfd *h = file->private_data;
+
+	return hostdev_map(h->fd, (u64)vma->vm_pgoff << PAGE_SHIFT, vma);
+}
+
+static loff_t hostfd_llseek(struct file *file, loff_t off, int whence)
+{
+	struct hostfd *h = file->private_data;
+
+	return hostdev_user_lseek(h->fd, off, whence);
+}
+
+/* Small pointer-free ioctls (dma-buf sync, sync file), in the kernel process */
+static long hostfd_ioctl(struct file *file, unsigned int cmd,
+			 unsigned long arg)
+{
+	struct hostfd *h = file->private_data;
+	unsigned int size = _IOC_SIZE(cmd);
+	char buf[64];
+	long ret;
+
+	if (cmd != DMA_BUF_IOCTL_SYNC && cmd != DMA_BUF_IOCTL_EXPORT_SYNC_FILE &&
+	    cmd != DMA_BUF_IOCTL_IMPORT_SYNC_FILE && cmd != SYNC_IOC_MERGE)
+		return -ENOTTY;
+	memset(buf, 0, sizeof(buf));
+	if ((_IOC_DIR(cmd) & _IOC_WRITE) &&
+	    copy_from_user(buf, (void __user *)arg, size))
+		return -EFAULT;
+
+	if (cmd == SYNC_IOC_MERGE) {
+		struct sync_merge_data *m = (void *)buf;
+		struct file *f2;
+		int fd2 = um_hostfd_of_fd(m->fd2, &f2);
+
+		if (fd2 < 0)
+			return fd2;
+		m->fd2 = fd2;
+		ret = hostdev_user_ioctl(h->fd, cmd, buf);
+		fput(f2);
+		if (!ret) {
+			m->fence = hostfd_install(m->fence);
+			if (m->fence < 0)
+				ret = m->fence;
+		}
+	} else if (cmd == DMA_BUF_IOCTL_EXPORT_SYNC_FILE) {
+		struct dma_buf_export_sync_file *e = (void *)buf;
+
+		ret = hostfd_ioctl_fd(h->fd, cmd, buf, &e->fd, false, true);
+	} else if (cmd == DMA_BUF_IOCTL_IMPORT_SYNC_FILE) {
+		struct dma_buf_import_sync_file *e = (void *)buf;
+
+		ret = hostfd_ioctl_fd(h->fd, cmd, buf, &e->fd, true, false);
+	} else {
+		ret = hostdev_user_ioctl(h->fd, cmd, buf);
+	}
+	if ((_IOC_DIR(cmd) & _IOC_READ) &&
+	    copy_to_user((void __user *)arg, buf, size))
+		return -EFAULT;
+	return ret;
+}
+
+static int hostfd_release(struct inode *inode, struct file *file)
+{
+	struct hostfd *h = file->private_data;
+
+	os_close_file(h->fd);
+	kfree(h);
+	return 0;
+}
+
+static const struct file_operations hostfd_fops = {
+	.owner = THIS_MODULE,
+	.release = hostfd_release,
+	.unlocked_ioctl = hostfd_ioctl,
+	.mmap = hostfd_mmap,
+	.llseek = hostfd_llseek,
+};
+
+static int hostshm_open(struct inode *inode, struct file *file)
+{
+	struct hostfd *h = kzalloc(sizeof(*h), GFP_KERNEL);
+
+	if (!h)
+		return -ENOMEM;
+	h->fd = hostdev_user_memfd(4);
+	if (h->fd < 0) {
+		int err = h->fd;
+
+		kfree(h);
+		return err;
+	}
+	file->private_data = h;
+	return 0;
+}
+
+static const struct file_operations hostshm_fops = {
+	.owner = THIS_MODULE,
+	.open = hostshm_open,
+	.release = hostfd_release,
+	.mmap = hostfd_mmap,
+	.llseek = hostfd_llseek,
+};
+
+static struct miscdevice hostshm_misc = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "hostshm",
+	.fops = &hostshm_fops,
+	.mode = 0666,
+};
+
+/* sock: one connection to a host unix socket per open */
+
+struct hostsock {
+	int fd;
+	int irq;
+	wait_queue_head_t wq;
+};
+
+#define HOSTSOCK_CHUNK	(64 << 10)
+
+static irqreturn_t hostsock_irq(int irq, void *data)
+{
+	struct hostsock *hs = data;
+
+	wake_up_interruptible(&hs->wq);
+	return IRQ_HANDLED;
+}
+
+static int hostsock_open(struct inode *inode, struct file *file)
+{
+	struct hostdev *dev = container_of(inode->i_cdev, struct hostdev, cdev);
+	struct hostsock *hs = kzalloc(sizeof(*hs), GFP_KERNEL);
+	int err;
+
+	if (!hs)
+		return -ENOMEM;
+	init_waitqueue_head(&hs->wq);
+	hs->fd = hostdev_user_connect(dev->host);
+	if (hs->fd < 0) {
+		err = hs->fd;
+		goto out;
+	}
+	hs->irq = um_request_irq(UM_IRQ_ALLOC, hs->fd, IRQ_READ, hostsock_irq,
+				 0, "hostsock", hs);
+	if (hs->irq < 0) {
+		err = hs->irq;
+		os_close_file(hs->fd);
+		goto out;
+	}
+	file->private_data = hs;
+	return stream_open(inode, file);
+out:
+	kfree(hs);
+	return err;
+}
+
+static int hostsock_release(struct inode *inode, struct file *file)
+{
+	struct hostsock *hs = file->private_data;
+
+	um_free_irq(hs->irq, hs);
+	os_close_file(hs->fd);
+	kfree(hs);
+	return 0;
+}
+
+static ssize_t hostsock_read(struct file *file, char __user *ubuf, size_t len,
+			     loff_t *ppos)
+{
+	struct hostsock *hs = file->private_data;
+	void *buf;
+	long n;
+
+	len = min_t(size_t, len, HOSTSOCK_CHUNK);
+	buf = kvmalloc(len, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	for (;;) {
+		n = hostdev_user_recv(hs->fd, buf, len);
+		if (n != -EAGAIN)
+			break;
+		if (file->f_flags & O_NONBLOCK)
+			break;
+		n = wait_event_interruptible(hs->wq, hostdev_user_poll(hs->fd) &
+					     (HOSTDEV_POLL_IN | HOSTDEV_POLL_HUP));
+		if (n)
+			break;
+	}
+	if (n > 0 && copy_to_user(ubuf, buf, n))
+		n = -EFAULT;
+	kvfree(buf);
+	return n;
+}
+
+/* The host socket buffer is full: the peer is a local process, try again */
+static long hostsock_send(struct hostsock *hs, const void *buf, size_t len,
+			  const int *fds, int nfds)
+{
+	long n;
+
+	for (;;) {
+		n = hostdev_user_send(hs->fd, buf, len, fds, nfds);
+		if (n != -EAGAIN)
+			return n;
+		if (msleep_interruptible(1))
+			return -ERESTARTSYS;
+	}
+}
+
+static ssize_t hostsock_write(struct file *file, const char __user *ubuf,
+			      size_t len, loff_t *ppos)
+{
+	struct hostsock *hs = file->private_data;
+	void *buf;
+	long n;
+
+	len = min_t(size_t, len, HOSTSOCK_CHUNK);
+	buf = kvmalloc(len, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	if (copy_from_user(buf, ubuf, len))
+		n = -EFAULT;
+	else
+		n = hostsock_send(hs, buf, len, NULL, 0);
+	kvfree(buf);
+	return n;
+}
+
+static __poll_t hostsock_poll(struct file *file, poll_table *wait)
+{
+	struct hostsock *hs = file->private_data;
+	int ev;
+
+	poll_wait(file, &hs->wq, wait);
+	ev = hostdev_user_poll(hs->fd);
+	return ((ev & HOSTDEV_POLL_IN) ? EPOLLIN | EPOLLRDNORM : 0) |
+	       ((ev & HOSTDEV_POLL_HUP) ? EPOLLHUP | EPOLLIN : 0) |
+	       EPOLLOUT | EPOLLWRNORM;
+}
+
+static long hostsock_ioctl(struct file *file, unsigned int cmd,
+			   unsigned long arg)
+{
+	struct hostsock *hs = file->private_data;
+	struct file *files[HOSTDEV_MAX_FDS];
+	int fds[HOSTDEV_MAX_FDS];
+	struct hostsock_send s;
+	void *buf = NULL;
+	long ret;
+	int i = 0;
+
+	if (cmd != HOSTSOCK_SEND)
+		return -ENOTTY;
+	if (copy_from_user(&s, (void __user *)arg, sizeof(s)))
+		return -EFAULT;
+	if (!s.len || s.len > HOSTSOCK_CHUNK || s.nfds > HOSTDEV_MAX_FDS)
+		return -EINVAL;
+
+	for (i = 0; i < s.nfds; i++) {
+		fds[i] = um_hostfd_of_fd(s.fds[i], &files[i]);
+		if (fds[i] < 0) {
+			ret = fds[i];
+			goto out;
+		}
+	}
+	buf = kvmalloc(s.len, GFP_KERNEL);
+	if (!buf)
+		ret = -ENOMEM;
+	else if (copy_from_user(buf, u64_to_user_ptr(s.data), s.len))
+		ret = -EFAULT;
+	else
+		ret = hostsock_send(hs, buf, s.len, fds, s.nfds);
+out:
+	while (i--)
+		fput(files[i]);
+	kvfree(buf);
+	return ret;
+}
+
+static const struct file_operations hostsock_fops = {
+	.owner = THIS_MODULE,
+	.open = hostsock_open,
+	.release = hostsock_release,
+	.read = hostsock_read,
+	.write = hostsock_write,
+	.poll = hostsock_poll,
+	.unlocked_ioctl = hostsock_ioctl,
+};
+
+static int hostdev_open(struct inode *inode, struct file *file)
+{
+	struct hostdev *dev = container_of(inode->i_cdev, struct hostdev, cdev);
+	struct hostdev_file *hf;
+
+	hf = kzalloc(sizeof(*hf), GFP_KERNEL);
+	if (!hf)
+		return -ENOMEM;
+
+	hf->fd = os_open_file(dev->host, of_cloexec(of_rdwr(OPENFLAGS())), 0);
+	if (hf->fd < 0) {
+		int err = hf->fd;
+
+		kfree(hf);
+		return err;
+	}
+	hf->dev = dev;
+	xa_init_flags(&hf->offsets, XA_FLAGS_ALLOC);
+	mutex_init(&hf->lock);
+	file->private_data = hf;
+	return 0;
+}
+
+static int hostdev_release(struct inode *inode, struct file *file)
+{
+	struct hostdev_file *hf = file->private_data;
+
+	os_close_file(hf->fd);
+	xa_destroy(&hf->offsets);
+	kfree(hf);
+	return 0;
+}
+
+static const struct file_operations hostdev_fops = {
+	.owner = THIS_MODULE,
+	.open = hostdev_open,
+	.release = hostdev_release,
+	.unlocked_ioctl = hostdev_ioctl,
+	.mmap = hostdev_mmap,
+	.llseek = noop_llseek,
+};
+
+static char *hostdev_devnode(const struct device *dev, umode_t *mode)
+{
+	struct hostdev *hd = dev_get_drvdata(dev);
+
+	if (mode)
+		*mode = 0666;
+	return hd ? kstrdup(hd->name, GFP_KERNEL) : NULL;
+}
+
+static struct class hostdev_class = {
+	.name = "hostdev",
+	.devnode = hostdev_devnode,
+};
+
+/* libdrm tells a DRM node by /sys/dev/char/M:m/device/drm */
+static struct class hostdev_drm_class = {
+	.name = "drm",
+	.devnode = hostdev_devnode,
+};
+
+static int __init hostdev_setup(char *str)
+{
+	struct hostdev *hd = &hostdevs[hostdev_count];
+	char *host, *name, *devt, *opt;
+	unsigned int major, minor;
+
+	if (hostdev_count == HOSTDEV_MAX)
+		return 1;
+	host = strsep(&str, ",");
+	name = strsep(&str, ",");
+	devt = strsep(&str, ",");
+	if (!host || !name || !devt ||
+	    sscanf(devt, "%u:%u", &major, &minor) != 2) {
+		pr_err("hostdev: expected <host path>,<guest name>,<major>:<minor>[,drm]\n");
+		return 1;
+	}
+	while ((opt = strsep(&str, ",")) != NULL) {
+		if (!strcmp(opt, "drm"))
+			hd->flags |= HOSTDEV_DRM;
+		else if (!strcmp(opt, "direct"))
+			hd->flags |= HOSTDEV_DIRECT;
+		else if (!strcmp(opt, "sock"))
+			hd->flags |= HOSTDEV_SOCK;
+	}
+	hd->host = host;
+	hd->name = name;
+	hd->devt = MKDEV(major, minor);
+	hostdev_count++;
+	return 1;
+}
+__setup("hostdev=", hostdev_setup);
+
+static int __init hostdev_init(void)
+{
+	struct device *parent = NULL, *d;
+	bool drm = false;
+	int i, err;
+
+	if (!hostdev_count)
+		return 0;
+
+	for (i = 0; i < hostdev_count; i++)
+		drm |= hostdevs[i].flags & HOSTDEV_DRM;
+
+	err = class_register(&hostdev_class);
+	if (err)
+		return err;
+	misc_register(&hostshm_misc);
+	if (drm) {
+		struct platform_device *pdev;
+
+		err = class_register(&hostdev_drm_class);
+		if (err)
+			return err;
+		pdev = platform_device_register_simple("hostdev-drm", -1,
+						       NULL, 0);
+		if (IS_ERR(pdev))
+			return PTR_ERR(pdev);
+		parent = &pdev->dev;
+	}
+
+	for (i = 0; i < hostdev_count; i++) {
+		struct hostdev *hd = &hostdevs[i];
+		bool is_drm = hd->flags & HOSTDEV_DRM;
+
+		err = register_chrdev_region(hd->devt, 1, "hostdev");
+		if (err) {
+			pr_err("hostdev: %s: device number taken\n", hd->name);
+			continue;
+		}
+		cdev_init(&hd->cdev, (hd->flags & HOSTDEV_SOCK) ?
+			  &hostsock_fops : &hostdev_fops);
+		err = cdev_add(&hd->cdev, hd->devt, 1);
+		if (err)
+			continue;
+		d = device_create(is_drm ? &hostdev_drm_class : &hostdev_class,
+				  is_drm ? parent : NULL, hd->devt, hd, "%s",
+				  kbasename(hd->name));
+		if (IS_ERR(d)) {
+			pr_err("hostdev: %s: %ld\n", hd->name, PTR_ERR(d));
+			continue;
+		}
+		pr_info("hostdev: /dev/%s is host %s\n", hd->name, hd->host);
+	}
+	return 0;
+}
+device_initcall(hostdev_init);
diff --git a/arch/um/drivers/hostdev_user.c b/arch/um/drivers/hostdev_user.c
new file mode 100644
index 000000000000..0c4a1fe83bfa
--- /dev/null
+++ b/arch/um/drivers/hostdev_user.c
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Host side of hostdev_kern.c: calls made by the kernel process itself. */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <sys/syscall.h>
+#include <sys/un.h>
+#include "hostdev.h"
+
+long hostdev_user_ioctl(int fd, unsigned long cmd, void *arg)
+{
+	long ret;
+
+	do {
+		ret = ioctl(fd, cmd, arg);
+	} while (ret < 0 && errno == EINTR);
+	return ret < 0 ? -errno : ret;
+}
+
+int hostdev_user_memfd(unsigned long size)
+{
+	int fd = syscall(__NR_memfd_create, "um-hostshm", MFD_CLOEXEC);
+
+	if (fd < 0)
+		return -errno;
+	if (ftruncate(fd, size)) {
+		int err = -errno;
+
+		close(fd);
+		return err;
+	}
+	return fd;
+}
+
+long long hostdev_user_lseek(int fd, long long off, int whence)
+{
+	off_t ret = lseek(fd, off, whence);
+
+	return ret < 0 ? -errno : ret;
+}
+
+/* Connect to a unix socket; "@name" is an abstract one. Non-blocking after. */
+int hostdev_user_connect(const char *path)
+{
+	struct sockaddr_un sun = { .sun_family = AF_UNIX };
+	size_t n = strlen(path);
+	int fd, err;
+
+	if (n >= sizeof(sun.sun_path))
+		return -ENAMETOOLONG;
+	memcpy(sun.sun_path, path, n);
+	if (path[0] == '@')
+		sun.sun_path[0] = 0;
+
+	fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+	if (fd < 0)
+		return -errno;
+	if (connect(fd, (struct sockaddr *)&sun,
+		    offsetof(struct sockaddr_un, sun_path) + n) < 0) {
+		err = -errno;
+		close(fd);
+		return err;
+	}
+	fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK);
+	return fd;
+}
+
+/* POLLIN/POLLHUP/POLLERR state right now */
+int hostdev_user_poll(int fd)
+{
+	struct pollfd p = { .fd = fd, .events = POLLIN | POLLOUT };
+
+	if (poll(&p, 1, 0) < 0)
+		return 0;
+	return ((p.revents & POLLIN) ? HOSTDEV_POLL_IN : 0) |
+	       ((p.revents & POLLOUT) ? HOSTDEV_POLL_OUT : 0) |
+	       ((p.revents & (POLLHUP | POLLERR)) ? HOSTDEV_POLL_HUP : 0);
+}
+
+long hostdev_user_send(int fd, const void *data, unsigned long len,
+		       const int *fds, int nfds)
+{
+	union {
+		char buf[CMSG_SPACE(sizeof(int) * HOSTDEV_MAX_FDS)];
+		struct cmsghdr align;
+	} ctrl;
+	struct iovec iov = { .iov_base = (void *)data, .iov_len = len };
+	struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+	long ret;
+
+	if (nfds) {
+		struct cmsghdr *cmsg;
+
+		memset(&ctrl, 0, sizeof(ctrl));
+		msg.msg_control = ctrl.buf;
+		msg.msg_controllen = CMSG_SPACE(sizeof(int) * nfds);
+		cmsg = CMSG_FIRSTHDR(&msg);
+		cmsg->cmsg_level = SOL_SOCKET;
+		cmsg->cmsg_type = SCM_RIGHTS;
+		cmsg->cmsg_len = CMSG_LEN(sizeof(int) * nfds);
+		memcpy(CMSG_DATA(cmsg), fds, sizeof(int) * nfds);
+	}
+	do {
+		ret = sendmsg(fd, &msg, MSG_NOSIGNAL);
+	} while (ret < 0 && errno == EINTR);
+	return ret < 0 ? -errno : ret;
+}
+
+long hostdev_user_recv(int fd, void *data, unsigned long len)
+{
+	long ret;
+
+	do {
+		ret = recv(fd, data, len, 0);
+	} while (ret < 0 && errno == EINTR);
+	return ret < 0 ? -errno : ret;
+}
