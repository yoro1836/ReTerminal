+ * spaces stubs have (measured on an S24: munmap 10.4 vs 4.6us, map+touch 15.3
+ * vs 8.7us). So after a page-level unmap, each 2MB chunk gets one PROT_NONE
+ * anonymous "anchor" mapping, placed on a guest page with nothing mapped (a
+ * guest access there faults just like a hole would, and a later map simply
+ * replaces it). One extra host VMA per chunk; anchors are only remembered in
+ * a small per-mm cache, a forgotten one costs nothing but a VMA.
+ */
+#define ANCHOR_CHUNK	(2UL << 20)
+#define ANCHOR_FLOOR	(1UL << 20)	/* stay above any host mmap_min_addr */
+
+static inline unsigned long *anchor_slot(struct mm_struct *mm, unsigned long a)
+{
+	return &mm->context.anchors[(a / ANCHOR_CHUNK) % UM_ANCHORS];
+}
