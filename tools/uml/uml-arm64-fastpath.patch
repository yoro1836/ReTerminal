diff --git a/arch/um/kernel/trap.c b/arch/um/kernel/trap.c
index e9f3063c6355..556551c92022 100644
--- a/arch/um/kernel/trap.c
+++ b/arch/um/kernel/trap.c
@@ -394,6 +394,98 @@ static bool um_prefault_around(struct mm_struct *mm, struct vm_area_struct *vma,
