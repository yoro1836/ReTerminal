+static void um_tlb_anchor(struct vm_ops *ops, pmd_t *pmd, unsigned long addr)
+{
+	unsigned long chunk = addr & ~(ANCHOR_CHUNK - 1), va;
+	unsigned long *slot = anchor_slot(ops->mm, addr);
+	pte_t *pte;
+
+	if (*slot && (*slot & ~(ANCHOR_CHUNK - 1)) == chunk)
+		return;
+	if (chunk < ANCHOR_FLOOR || chunk + ANCHOR_CHUNK > TASK_SIZE)
+		return;
+
+	pte = pte_offset_kernel(pmd, chunk);
+	for (va = chunk; va < chunk + ANCHOR_CHUNK; va += PAGE_SIZE, pte++) {
+		/* Not the page just unmapped: it is the one likely reused. */
+		if (va == addr || pte_present(*pte) || pte_needsync(*pte))
+			continue;
+		if (um_hostmap_find(ops->mm, va))
+			continue;
+		if (!ops->anchor(ops->mm_idp, va, PAGE_SIZE))
+			*slot = va;
+		return;
+	}
