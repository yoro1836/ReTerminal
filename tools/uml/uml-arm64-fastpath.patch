From c8d8a77cb91ed96de8dbff4da1d2120b1243f350 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 07:17:58 +0000
Subject: [PATCH 02/18] um/arm64: fastpath fixes (slot floor, stub-only
 stores), any svc site, memfd physmem, spin 200

---
 arch/arm64/um/fastpath.c                    | 43 +++++++++++------
 arch/arm64/um/shared/sysdep/stub-fastpath.h | 52 ++++++++++++---------
 arch/um/os-Linux/mem.c                      | 50 ++++++++++++++++++++
 arch/um/os-Linux/skas/process.c             |  4 +-
 4 files changed, 109 insertions(+), 40 deletions(-)

diff --git a/arch/arm64/um/fastpath.c b/arch/arm64/um/fastpath.c
index b120da2320f7..78e8e3dc3aae 100644
--- a/arch/arm64/um/fastpath.c
+++ b/arch/arm64/um/fastpath.c
@@ -13,10 +13,12 @@
  * mapped within branch range of the site, which fork() copies like any other
  * memory, so a child inherits patched sites together with their slots.
  *
- * Only "mov {w,x}8, #nr; svc #0" sites are patched, so the number at a patched
- * site is fixed. Calls that replace or end the whole register state are left
- * alone; everything else is safe because the stub falls back to a real
- * rt_sigreturn whenever the kernel resumes anywhere but right after the site.
+ * Any "svc #0" in ordinary text can be patched: the stub reads the number
+ * from x8 like the host would, so wrappers such as libc's syscall() qualify
+ * too. A site is not patched while it is being used for a call that replaces
+ * or ends the whole register state, but whatever later comes through a slot
+ * is still safe: the stub falls back to a real rt_sigreturn whenever the
+ * kernel resumes anywhere but right after the site, on the same stack.
  */
 #include <linux/kernel.h>
 #include <linux/init.h>
@@ -36,6 +38,7 @@
 #include <as-layout.h>
 #include <init.h>
 #include <skas.h>
+#include <stub-data.h>
 
 #define FP_THRESHOLD	64
 #define FP_SITES	256	/* per mm, open addressing */
@@ -45,10 +48,14 @@
 #define FP_SLOT_SIZE	32
 #define FP_SLOTS	((PAGE_SIZE - 8) / FP_SLOT_SIZE)
 #define FP_RANGE	(120UL << 20)	/* b reaches +-128 MiB */
+/*
+ * The host has its own mmap_min_addr (32 KiB on Android) that the guest does
+ * not know about: a slot page below it can never be mapped by the stub, and
+ * the failed mmap silently drops the rest of that sync batch.
+ */
+#define FP_LOW_FLOOR	(1UL << 20)
 
 #define INSN_SVC0	0xd4000001u
-#define INSN_MOVZ_W8	0x52800008u
-#define INSN_MOVZ_X8	0xd2800008u
 
 struct um_fastpath {
 	spinlock_t lock;	/* site table */
@@ -125,7 +132,7 @@ static unsigned long fp_new_page(struct mm_struct *mm, unsigned long site)
 	unsigned long lo = site > FP_RANGE ? site - FP_RANGE : 0;
 	unsigned long hi = min(site + FP_RANGE, (unsigned long)TASK_SIZE);
 
-	lo = max(lo, PAGE_ALIGN(max(mmap_min_addr, PAGE_SIZE)));
+	lo = max(lo, PAGE_ALIGN(max(mmap_min_addr, FP_LOW_FLOOR)));
 	info.length = PAGE_SIZE;
 	info.low_limit = lo;
 	info.high_limit = hi;
@@ -185,22 +192,19 @@ static int fp_patch(struct mm_struct *mm, struct um_fastpath *fp,
 {
 	struct vm_area_struct *vma;
 	unsigned long slot, ret = site + 4;
-	u32 insn[2], code[8], b;
+	u32 insn, code[8], b;
 	bool ok;
 
-	if (site < 4 || copy_from_user(insn, (void __user *)(site - 4), 8))
+	if (copy_from_user(&insn, (void __user *)site, 4))
 		return -EFAULT;
-	if (insn[1] != INSN_SVC0 ||
-	    (insn[0] != (INSN_MOVZ_W8 | (u32)nr << 5) &&
-	     insn[0] != (INSN_MOVZ_X8 | (u32)nr << 5)))
+	if (insn != INSN_SVC0)
 		return -EINVAL;
 
 	/* File-backed, private, executable, not writable: ordinary text. */
 	mmap_read_lock(mm);
 	vma = vma_lookup(mm, site);
 	ok = vma && vma->vm_file && (vma->vm_flags & VM_EXEC) &&
-	     !(vma->vm_flags & (VM_WRITE | VM_SHARED)) &&
-	     vma->vm_start <= site - 4;
+	     !(vma->vm_flags & (VM_WRITE | VM_SHARED));
 	mmap_read_unlock(mm);
 	if (!ok)
 		return -EINVAL;
@@ -244,6 +248,10 @@ void um_fastpath_syscall(unsigned long pc, long nr)
 	    (current->ptrace & PT_PTRACED))
 		return;
 
+	/* Entered through a slot: the site is patched already. */
+	if (((struct stub_data *)mm->context.id.stack)->fast_busy)
+		return;
+
 	fp = READ_ONCE(mm->context.fastpath);
 	if (!fp) {
 		struct um_fastpath *new = kzalloc(sizeof(*new), GFP_KERNEL);
@@ -280,9 +288,14 @@ void um_fastpath_syscall(unsigned long pc, long nr)
 	spin_unlock(&fp->lock);
 
 	if (patch) {
+		int r;
+
 		mutex_lock(&fp->patch);
-		fp_patch(mm, fp, site, nr);
+		r = fp_patch(mm, fp, site, nr);
 		mutex_unlock(&fp->patch);
+		if (r && r != -EINVAL)
+			pr_debug("fastpath: pid %d site %lx nr %ld: %d\n",
+				 current->pid, site, nr, r);
 	}
 }
 
