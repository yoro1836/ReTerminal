+int um_fork_young = 1;
+core_param(fork_young, um_fork_young, int, 0644);
+
+/*
+ * fork() write-protects every private page of the parent, and each one the
+ * parent writes to afterwards is a fault of its own even when the child is
+ * long gone and the page is the parent's alone again. A write fault on such a
+ * page is a good sign that its neighbours are next, so give write access back
+ * to those of them that need no copy, on the same handoff: pages that were
+ * dirty and writable before, and that nobody else holds. With tlb_protect
+ * they sync as a few mprotect ranges.
+ *
+ * The checks here only pick candidates; handle_mm_fault() decides. If one
+ * turns out shared after all it is copied, as it would be on a real write.
+ */
+static unsigned int um_wp_around_pages __read_mostly = 64;
+core_param(wp_around, um_wp_around_pages, uint, 0644);
+
+/* A write to a page that is mapped, accessed and dirty, but read-only? */
+static bool um_wp_candidate(pte_t pte)
+{
+	return (pte_val(pte) & (_PAGE_PRESENT | _PAGE_RW | _PAGE_ACCESSED |
+				_PAGE_DIRTY)) ==
+	       (_PAGE_PRESENT | _PAGE_ACCESSED | _PAGE_DIRTY);
