From 9e6e6fadc0992c466ee6ca08157704949ac87171 Mon Sep 17 00:00:00 2001
From: gpt2 <gpt2@localhost>
Date: Thu, 26 Nov 2026 05:16:04 +0000
Subject: [PATCH 34/39] um: start a thread group's second live thread locally

Thread creation followed by a join can wake another vCPU twice: once
to start the child and once to wake the joiner from its futex. Each
cross-vCPU wake can send a host signal.

Extend the existing fork_local policy to the second live thread when
the creator's runqueue meets the local-placement threshold. Normal
load balancing can still move runnable tasks to an idle CPU.

Across three paired boots with two vCPUs and seccomp_spin=0, median
pthread create plus join fell from 1200.67 us to 493.13 us.
---
 kernel/sched/fair.c | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 2ff9bde44d88..f7dc0663b328 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -9924,9 +9924,10 @@ static int find_energy_efficient_cpu(struct task_struct *p, int prev_cpu)
 #ifdef CONFIG_UML
 /*
  * A cross-CPU wakeup is a host signal to a sleeping vCPU thread, far more
- * than the fork it serves when the parent is about to wait for the child.
- * Keep a forked child on a CPU that runs nothing but its parent, when it is
- * the parent's only child: one that runs several at once wants them spread.
+ * than the fork it serves when the creator is about to wait for the new task.
+ * Keep an only child or the second live thread of a thread group on the
+ * creator's CPU when it has no other runnable tasks. Idle load balancing can
+ * still pull runnable tasks onto other CPUs.
  */
 static int um_fork_local = 1;
 core_param(fork_local, um_fork_local, int, 0644);
@@ -9949,9 +9950,12 @@ select_task_rq_fair(struct task_struct *p, int prev_cpu, int wake_flags)
 	lockdep_assert_held(&p->pi_lock);
 #ifdef CONFIG_UML
 	if ((wake_flags & WF_FORK) && um_fork_local &&
-	    p->mm != current->mm && list_is_singular(&current->children) &&
 	    this_rq()->nr_running <= um_fork_local &&
-	    cpumask_test_cpu(cpu, p->cpus_ptr))
+	    cpumask_test_cpu(cpu, p->cpus_ptr) &&
+	    ((p->mm != current->mm && list_is_singular(&current->children)) ||
+	     (p->mm && p->mm == current->mm &&
+	      same_thread_group(p, current) &&
+	      atomic_read(&p->signal->live) == 2)))
 		return cpu;
 #endif
 	if (wake_flags & WF_TTWU) {
