From 2bfac0042505ad580ea2f473efb6b9886bfff107 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 25 Nov 2026 07:08:57 +0000
Subject: [PATCH 32/39] um/arm64: take memcpy/memset/memmove/memcmp from glibc
 too

lib/string.c's versions are byte loops. On a glibc arm64 host a 16K
clear_page() was a third of the kernel's time in fork(), and the FP
register copies were a quarter of a syscall. Bionic builds already
used libc's.

A1 (Neoverse N1): fork+exit 680 -> 270us, mmap+touch+munmap 80 -> 22us.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01B3kysVLGNgK27oVbqXzFEn
---
 arch/arm64/um/asm/string.h | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/arch/arm64/um/asm/string.h b/arch/arm64/um/asm/string.h
index 437043633611..5bb0c1c89989 100644
--- a/arch/arm64/um/asm/string.h
+++ b/arch/arm64/um/asm/string.h
@@ -64,6 +64,21 @@ char *strchrnul(const char *, int);
 __kernel_size_t strlen(const char *);
 int strncmp(const char *, const char *, __kernel_size_t);
 __kernel_size_t strnlen(const char *, __kernel_size_t);
+#else
+/*
+ * Against glibc, take at least the bulk memory routines from libc too.
+ * lib/string.c's are byte loops: a 16K clear_page() was a third of the
+ * kernel's time in fork() on an arm64 host. The str* family stays generic
+ * (see above for strrchr).
+ */
+#define __HAVE_ARCH_MEMCPY
+#define __HAVE_ARCH_MEMSET
+#define __HAVE_ARCH_MEMMOVE
+#define __HAVE_ARCH_MEMCMP
+void *memcpy(void *, const void *, __kernel_size_t);
+void *memset(void *, int, __kernel_size_t);
+void *memmove(void *, const void *, __kernel_size_t);
+int memcmp(const void *, const void *, __kernel_size_t);
 #endif
 
 #endif /* __UM_ARM64_STRING_H */
-- 
