+static void um_vdso_time_set(struct um_vdso_time *t, u64 sec, u64 nsec,
+			     u32 shift)
+{
+	while (nsec >= ((u64)NSEC_PER_SEC << shift)) {
+		nsec -= (u64)NSEC_PER_SEC << shift;
+		sec++;
+	}
+	t->sec = sec;
+	t->nsec = nsec;
+}
+
+void update_vsyscall(struct timekeeper *tk);
+void update_vsyscall_tz(void);
+
+/* Called by the timekeeping core with its lock held: one writer. */
+void update_vsyscall(struct timekeeper *tk)
+{
+	const struct tk_read_base *r = &tk->tkr_mono;
+	struct um_vdso_data *d = um_vdata;
