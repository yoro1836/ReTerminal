+	static const char *const f[] = {
+		"/sys/devices/system/cpu/cpu%d/cpu_capacity",
+		"/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq",
+	};
+	char path[96], buf[24];
+	int i, fd, n;
+
+	if (cpu < 0 || cpu >= 64)
+		return 0;
+	for (i = 0; i < 2; i++) {
+		snprintf(path, sizeof(path), f[i], cpu);
+		fd = open(path, O_RDONLY | O_CLOEXEC);
+		if (fd < 0)
+			continue;
+		n = read(fd, buf, sizeof(buf) - 1);
+		close(fd);
+		if (n > 0) {
+			buf[n] = 0;
+			return strtoul(buf, NULL, 10);
+		}
+	}
+	return cpuinfo_capacity(cpu);
+}
+
+/* Strongest CPU in mask; ties (or no capacity info) go to the highest number. */
+static int fastest_cpu(unsigned long m)
+{
+	int c, best = -1, cap = -1;
+
+	for (c = 0; c < 64; c++) {
+		int v;
+
+		if (!(m >> c & 1))
+			continue;
+		v = cpu_capacity(c);
+		if (v >= cap) {
+			cap = v;
+			best = c;
+		}
+	}
+	return best;
+}
+
+/*
+ * The CPUs in m at least half as strong as the best of them. Guest code and
+ * the host mmap/munmap a stub runs are several times slower on little cores
+ * (S24: host munmap 13us on A520, 3us on A720, 2us on X4).
+ */
+static unsigned long fast_cpus(unsigned long m)
+{
+	unsigned long fast = 0;
+	int best = cpu_capacity(fastest_cpu(m));
+	int c;
+
+	for (c = 0; c < 64 && best > 0; c++)
+		if ((m >> c & 1) && cpu_capacity(c) * 2 > best)
+			fast |= 1UL << c;
+	return fast ? fast : m;
+}
+
+/*
+ * stub_pin=1 with SMP: the whole kernel (vCPU threads, stubs) stays on the
+ * fast CPUs of the affinity it was started with. Called before any CPU
+ * thread or stub exists, so all of them inherit it.
+ */
+void os_pin_fast_cpus(void)
+{
+	unsigned long m = 0, f;
+	int c;
+
+	if (!stub_pin || uml_ncpus <= 1)
+		return;
+	if (syscall(__NR_sched_getaffinity, 0, sizeof(m), &m) < 0) {
+		printk(UM_KERN_INFO "stub_pin: sched_getaffinity failed (%d), not pinning\n",
+		       errno);
+		return;
+	}
+	f = fast_cpus(m);
+	if (f == m) {
+		/* Logged with the capacities: unreadable sysfs looks like this. */
+		printk(UM_KERN_INFO "stub_pin: no slower host CPUs in %lx, not pinning; capacity:",
+		       m);
+		for (c = 0; c < 64; c++)
+			if (m >> c & 1)
+				printk(UM_KERN_CONT " %d", cpu_capacity(c));
+		printk(UM_KERN_CONT "\n");
+		return;
+	}
+	/* More vCPUs than fast cores: squeezing them in would be worse. */
+	if (uml_ncpus > __builtin_popcountl(f)) {
+		printk(UM_KERN_INFO "stub_pin: %d CPUs > %d fast host CPUs (%lx), not pinning; use ncpus=%d\n",
+		       uml_ncpus, __builtin_popcountl(f), f,
+		       __builtin_popcountl(f));
+		return;
+	}
+	if (syscall(__NR_sched_setaffinity, 0, sizeof(f), &f) == 0)
+		printk(UM_KERN_INFO "stub_pin: SMP on fast CPUs %lx\n", f);
+	else
+		printk(UM_KERN_INFO "stub_pin: sched_setaffinity(%lx) failed (%d)\n",
+		       f, errno);
+}
+
+static unsigned long stub_pin_mask(void)
+{
+	static int done;
+	unsigned long m = 0, k;
+	int cpu;
+
+	if (!stub_pin || done)
+		return stub_cpumask;
+	done = 1;
+	/* SMP: the vCPU threads use the host CPUs; leave placement to the host. */
+	if (uml_ncpus > 1)
+		return 0;
+	if (syscall(__NR_sched_getaffinity, 0, sizeof(m), &m) < 0 ||
+	    __builtin_popcountl(m) < 2)
+		return 0;
+	cpu = fastest_cpu(m);
+	k = 1UL << cpu;
+	if (syscall(__NR_sched_setaffinity, 0, sizeof(k), &k) < 0)
+		return 0;
+	stub_cpumask = m & ~k;
+	/* Stubs off the little cores too, see fast_cpus(). */
+	stub_cpumask = fast_cpus(stub_cpumask);
+	printk(UM_KERN_INFO "stub_pin: kernel on CPU %d, stubs on %lx\n",
+	       cpu, stub_cpumask);
+	return stub_cpumask;
+}
