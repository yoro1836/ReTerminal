+	/*
+	 * Keep stubs (guest code and the host mmap/munmap the stub runs) off
+	 * the little cores: there the same host munmap takes 13us vs 2-3us.
+	 * Only CPUs at least half as strong as the best one left are used.
+	 */
+	{
+		unsigned long fast = 0;
+		int best = cpu_capacity(fastest_cpu(stub_cpumask));
+		int c;
+
+		for (c = 0; c < 64 && best > 0; c++)
+			if ((stub_cpumask >> c & 1) && cpu_capacity(c) * 2 > best)
+				fast |= 1UL << c;
+		if (fast)
+			stub_cpumask = fast;
+	}
