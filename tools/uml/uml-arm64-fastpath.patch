+static inline void um_fork_set_pte(struct mm_struct *mm, unsigned long addr,
+				   pte_t *dst, pte_t *src, pte_t pte)
+{
+	unsigned long diff = (pte_val(pte) ^ pte_val(*src)) &
+			     ~(unsigned long)(_PAGE_NEEDSYNC | _PAGE_PROTONLY);
