From 05f7662bf57f2e23f15e39e00f2cbd6173831897 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 27 Nov 2026 02:07:43 +0000
Subject: [PATCH 37/39] um: map 256K of page cache per file fault

Each fault is a trap plus a host mmap in UML. 64K fault-around left 25%
more faults on exec of a dynamic binary. Boot param fault_around_pages.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01B3kysVLGNgK27oVbqXzFEn
---
 mm/memory.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/mm/memory.c b/mm/memory.c
index 998187d40696..958dd02c7869 100644
--- a/mm/memory.c
+++ b/mm/memory.c
@@ -5889,8 +5889,20 @@ vm_fault_t finish_fault(struct vm_fault *vmf)
 	return ret;
 }
 
+#ifdef CONFIG_UML
+/*
+ * A fault costs UML a trap into the kernel plus a host mmap; mapping more of
+ * the page cache per fault saves later traps (exec of a dynamic binary: ~25%
+ * fewer faults at 256K).
+ */
+#include <linux/moduleparam.h>
+static unsigned long fault_around_pages __read_mostly =
+	262144 >> PAGE_SHIFT;
+core_param(fault_around_pages, fault_around_pages, ulong, 0644);
+#else
 static unsigned long fault_around_pages __read_mostly =
 	65536 >> PAGE_SHIFT;
+#endif
 
 #ifdef CONFIG_DEBUG_FS
 static int fault_around_bytes_get(void *data, u64 *val)
