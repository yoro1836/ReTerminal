 arch/um/kernel/mem.c          | 16 ++++++++--------
 arch/um/kernel/physmem.c      |  3 ++-
 arch/um/kernel/tlb.c          |  3 ++-
 4 files changed, 24 insertions(+), 11 deletions(-)

diff --git a/arch/um/include/asm/pgtable.h b/arch/um/include/asm/pgtable.h
index 585580905b45..672571e3a0d9 100644
--- a/arch/um/include/asm/pgtable.h
+++ b/arch/um/include/asm/pgtable.h
@@ -19,6 +19,13 @@
  * unlike the mmap merges across pages that are not adjacent in physmem.
  */
 #define _PAGE_PROTONLY	0x004
+/*
+ * User mappings with VM_EXEC. Without it every guest page went to the host
+ * PROT_EXEC, and an arm64 host cleans the D-cache and invalidates the
+ * I-cache for each new page it maps executable: most of the cost of a first
+ * touch of guest memory.
+ */
+#define _PAGE_EXEC	0x008
 #define _PAGE_RW	0x020
 #define _PAGE_USER	0x040
 #define _PAGE_ACCESSED	0x080
@@ -67,6 +74,9 @@ extern pgd_t swapper_pg_dir[PTRS_PER_PGD];
 #define PAGE_SHARED	__pgprot(_PAGE_PRESENT | _PAGE_RW | _PAGE_USER | _PAGE_ACCESSED)
 #define PAGE_COPY	__pgprot(_PAGE_PRESENT | _PAGE_USER | _PAGE_ACCESSED)
 #define PAGE_READONLY	__pgprot(_PAGE_PRESENT | _PAGE_USER | _PAGE_ACCESSED)
+#define PAGE_SHARED_EXEC	__pgprot(_PAGE_PRESENT | _PAGE_RW | _PAGE_USER | _PAGE_ACCESSED | _PAGE_EXEC)
+#define PAGE_COPY_EXEC	__pgprot(_PAGE_PRESENT | _PAGE_USER | _PAGE_ACCESSED | _PAGE_EXEC)
+#define PAGE_READONLY_EXEC	__pgprot(_PAGE_PRESENT | _PAGE_USER | _PAGE_ACCESSED | _PAGE_EXEC)
 #define PAGE_KERNEL	__pgprot(_PAGE_PRESENT | _PAGE_RW | _PAGE_DIRTY | _PAGE_ACCESSED)
 #define PAGE_KERNEL_EXEC	__pgprot(__PAGE_KERNEL_EXEC)
 
@@ -123,7 +133,8 @@ static inline int pte_read(pte_t pte)
 
 static inline int pte_exec(pte_t pte)
 {
-	return !pte_get_bits(pte, _PAGE_PROTNONE);
+	return pte_get_bits(pte, _PAGE_EXEC) &&
+	       !pte_get_bits(pte, _PAGE_PROTNONE);
 }
 
 static inline int pte_write(pte_t pte)
