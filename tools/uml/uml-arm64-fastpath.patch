diff --git a/arch/arm64/um/fastpath.c b/arch/arm64/um/fastpath.c
new file mode 100644
index 000000000000..b120da2320f7
--- /dev/null
+++ b/arch/arm64/um/fastpath.c
@@ -0,0 +1,293 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Syscall-site fast path, kernel half (CONFIG_UML_FASTPATH).
+ *
+ * Counts SECCOMP-mode guest syscalls per call site and, once a site has
+ * trapped FP_THRESHOLD times, rewrites its "svc #0" into a branch to a
+ * trampoline slot that enters the stub without a host signal. The stub half,
+ * and the slot layout, are described in <sysdep/stub-fastpath.h>.
+ *
+ * Both writes go through FOLL_FORCE, like a debugger's breakpoint: the site's
+ * page is copied on write in this mm only, so the file and every other
+ * process keep the original instruction. Slots live in anonymous r-x pages
+ * mapped within branch range of the site, which fork() copies like any other
+ * memory, so a child inherits patched sites together with their slots.
+ *
+ * Only "mov {w,x}8, #nr; svc #0" sites are patched, so the number at a patched
+ * site is fixed. Calls that replace or end the whole register state are left
+ * alone; everything else is safe because the stub falls back to a real
+ * rt_sigreturn whenever the kernel resumes anywhere but right after the site.
+ */
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/mman.h>
+#include <linux/highmem.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/mutex.h>
+#include <linux/hash.h>
+#include <linux/sched.h>
+#include <linux/uaccess.h>
+#include <linux/ptrace.h>
+#include <linux/security.h>
+#include <asm/mmu.h>
+#include <asm/unistd.h>
+#include <as-layout.h>
+#include <init.h>
+#include <skas.h>
+
+#define FP_THRESHOLD	64
+#define FP_SITES	256	/* per mm, open addressing */
+#define FP_PROBE	8
+#define FP_DONE		UINT_MAX
+#define FP_MAX_PAGES	16
+#define FP_SLOT_SIZE	32
+#define FP_SLOTS	((PAGE_SIZE - 8) / FP_SLOT_SIZE)
+#define FP_RANGE	(120UL << 20)	/* b reaches +-128 MiB */
+
+#define INSN_SVC0	0xd4000001u
+#define INSN_MOVZ_W8	0x52800008u
+#define INSN_MOVZ_X8	0xd2800008u
+
+struct um_fastpath {
+	spinlock_t lock;	/* site table */
+	struct mutex patch;	/* slot pages; patching sleeps */
+	unsigned int npages;
+	unsigned long page[FP_MAX_PAGES];
+	unsigned int used[FP_MAX_PAGES];
+	unsigned long site[FP_SITES];
+	unsigned int count[FP_SITES];
+};
+
+extern char __syscall_stub_start[];
+extern char stub_fast_entry[];
+
+static int fastpath_on = 1;
+static unsigned long fastpath_patched;
+
+static int __init uml_fastpath_setup(char *line, int *add)
+{
+	fastpath_on = simple_strtoul(line, NULL, 0) != 0;
+	return 0;
+}
+__uml_setup("fastpath=", uml_fastpath_setup,
+"fastpath=<0|1>\n"
+"    In SECCOMP mode, rewrite guest syscall sites that trap often so they\n"
+"    enter the stub without a host signal. Default: 1.\n\n");
+
+static bool fp_excluded(long nr)
+{
+	switch (nr) {
+	case __NR_rt_sigreturn:
+	case __NR_clone:
+	case __NR_clone3:
+	case __NR_execve:
+	case __NR_execveat:
+	case __NR_exit:
+	case __NR_exit_group:
+		return true;
+	}
+	return nr < 0 || nr > 0xffff;
+}
+
+/* Write @len bytes of code into @mm at @addr, breaking COW as ptrace would. */
+static int fp_poke(struct mm_struct *mm, unsigned long addr,
+		   const void *buf, size_t len)
+{
+	struct page *page;
+	void *k;
+	long got;
+
+	if (offset_in_page(addr) + len > PAGE_SIZE)
+		return -EINVAL;
+
+	mmap_read_lock(mm);
+	got = get_user_pages_remote(mm, addr, 1, FOLL_WRITE | FOLL_FORCE,
+				    &page, NULL);
+	mmap_read_unlock(mm);
+	if (got != 1)
+		return -EFAULT;
+
+	k = kmap_local_page(page) + offset_in_page(addr);
+	memcpy(k, buf, len);
+	/* Same physical page as the stub's mapping: make the I-side see it. */
+	__builtin___clear_cache(k, k + len);
+	kunmap_local(k);
+	put_page(page);
+	return 0;
+}
+
+static unsigned long fp_new_page(struct mm_struct *mm, unsigned long site)
+{
+	struct vm_unmapped_area_info info = {};
+	unsigned long addr, entry;
+	unsigned long lo = site > FP_RANGE ? site - FP_RANGE : 0;
+	unsigned long hi = min(site + FP_RANGE, (unsigned long)TASK_SIZE);
+
+	lo = max(lo, PAGE_ALIGN(max(mmap_min_addr, PAGE_SIZE)));
+	info.length = PAGE_SIZE;
+	info.low_limit = lo;
+	info.high_limit = hi;
+
+	mmap_read_lock(mm);
+	addr = vm_unmapped_area(&info);
+	mmap_read_unlock(mm);
+	if (IS_ERR_VALUE(addr))
+		return 0;
+
+	addr = vm_mmap(NULL, addr, PAGE_SIZE, PROT_READ | PROT_EXEC,
+		       MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, 0);
+	if (IS_ERR_VALUE(addr))
+		return 0;
+
+	entry = STUB_CODE + (stub_fast_entry - __syscall_stub_start);
+	if (fp_poke(mm, addr + PAGE_SIZE - 8, &entry, sizeof(entry))) {
+		vm_munmap(addr, PAGE_SIZE);
+		return 0;
+	}
+	return addr;
+}
+
+static long fp_dist(unsigned long a, unsigned long b)
+{
+	return (long)(a - b);
+}
+
+/* A free slot within branch range of @site, or 0. */
+static unsigned long fp_get_slot(struct mm_struct *mm, struct um_fastpath *fp,
+				 unsigned long site)
+{
+	unsigned long page;
+	unsigned int i;
+
+	for (i = 0; i < fp->npages; i++) {
+		long d = fp_dist(fp->page[i], site);
+
+		if (fp->used[i] < FP_SLOTS && d > -(long)FP_RANGE &&
+		    d < (long)FP_RANGE)
+			return fp->page[i] + FP_SLOT_SIZE * fp->used[i]++;
+	}
+
+	if (fp->npages == FP_MAX_PAGES)
+		return 0;
+	page = fp_new_page(mm, site);
+	if (!page)
+		return 0;
+	fp->page[fp->npages] = page;
+	fp->used[fp->npages] = 1;
+	fp->npages++;
+	return page;
+}
+
+static int fp_patch(struct mm_struct *mm, struct um_fastpath *fp,
+		    unsigned long site, long nr)
+{
+	struct vm_area_struct *vma;
+	unsigned long slot, ret = site + 4;
+	u32 insn[2], code[8], b;
+	bool ok;
+
+	if (site < 4 || copy_from_user(insn, (void __user *)(site - 4), 8))
+		return -EFAULT;
+	if (insn[1] != INSN_SVC0 ||
+	    (insn[0] != (INSN_MOVZ_W8 | (u32)nr << 5) &&
+	     insn[0] != (INSN_MOVZ_X8 | (u32)nr << 5)))
+		return -EINVAL;
+
+	/* File-backed, private, executable, not writable: ordinary text. */
+	mmap_read_lock(mm);
+	vma = vma_lookup(mm, site);
+	ok = vma && vma->vm_file && (vma->vm_flags & VM_EXEC) &&
+	     !(vma->vm_flags & (VM_WRITE | VM_SHARED)) &&
+	     vma->vm_start <= site - 4;
+	mmap_read_unlock(mm);
+	if (!ok)
+		return -EINVAL;
+
+	slot = fp_get_slot(mm, fp, site);
+	if (!slot)
+		return -ENOSPC;
+
+	code[0] = 0xa9bf47f0;				/* stp x16, x17, [sp, #-16]! */
+	code[1] = 0x10fffff1;				/* adr x17, slot */
+	code[2] = 0x58000010 |				/* ldr x16, <entry> */
+		  ((((slot & PAGE_MASK) + PAGE_SIZE - 8 - (slot + 8)) >> 2) << 5);
+	code[3] = 0xd61f0200;				/* br x16 */
+	code[4] = 0xa8c147f0;				/* ldp x16, x17, [sp], #16 */
+	code[5] = 0x14000000 |				/* b site + 4 */
+		  (((ret - (slot + 20)) >> 2) & 0x03ffffff);
+	code[6] = lower_32_bits(ret);			/* .quad site + 4 */
+	code[7] = upper_32_bits(ret);
+	if (fp_poke(mm, slot, code, sizeof(code)))
+		return -EFAULT;
+
+	/* svc and b may both be swapped under a running thread. */
+	b = 0x14000000 | (((slot - site) >> 2) & 0x03ffffff);
+	if (fp_poke(mm, site, &b, sizeof(b)))
+		return -EFAULT;
+
+	fastpath_patched++;
+	return 0;
+}
+
+/* Called for every SECCOMP-mode guest syscall, before it runs. */
+void um_fastpath_syscall(unsigned long pc, long nr)
+{
+	struct mm_struct *mm = current->mm;
+	struct um_fastpath *fp;
+	unsigned long site = pc - 4;
+	unsigned int h, i, slot = FP_SITES;
+	bool patch = false;
+
+	if (!fastpath_on || !using_seccomp || !mm || fp_excluded(nr) ||
+	    (current->ptrace & PT_PTRACED))
+		return;
+
+	fp = READ_ONCE(mm->context.fastpath);
+	if (!fp) {
+		struct um_fastpath *new = kzalloc(sizeof(*new), GFP_KERNEL);
+
+		if (!new)
+			return;
+		spin_lock_init(&new->lock);
+		mutex_init(&new->patch);
+		fp = cmpxchg(&mm->context.fastpath, NULL, new);
+		if (fp)
+			kfree(new);
+		else
+			fp = new;
+	}
+
+	h = hash_long(site, ilog2(FP_SITES));
+	spin_lock(&fp->lock);
+	for (i = 0; i < FP_PROBE; i++) {
+		unsigned int j = (h + i) % FP_SITES;
+
+		if (fp->site[j] == site || !fp->site[j]) {
+			slot = j;
+			break;
+		}
+	}
+	if (slot < FP_SITES && fp->count[slot] != FP_DONE) {
+		fp->site[slot] = site;
+		if (++fp->count[slot] >= FP_THRESHOLD) {
+			/* One attempt per site, whatever it gives. */
+			fp->count[slot] = FP_DONE;
+			patch = true;
+		}
+	}
+	spin_unlock(&fp->lock);
+
+	if (patch) {
+		mutex_lock(&fp->patch);
+		fp_patch(mm, fp, site, nr);
+		mutex_unlock(&fp->patch);
+	}
+}
+
+void um_fastpath_destroy(struct mm_struct *mm)
+{
+	kfree(mm->context.fastpath);
+	mm->context.fastpath = NULL;
+}
diff --git a/arch/arm64/um/shared/sysdep/stub-fastpath.h b/arch/arm64/um/shared/sysdep/stub-fastpath.h
new file mode 100644
index 000000000000..f7d69352d9b0
--- /dev/null
+++ b/arch/arm64/um/shared/sysdep/stub-fastpath.h
@@ -0,0 +1,293 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Syscall-site fast path, stub half (CONFIG_UML_FASTPATH).
+ *
+ * In SECCOMP mode every guest syscall is a SIGSYS: the host builds a signal
+ * frame on the stub's sigstack, the handler hands it to the kernel, and an
+ * rt_sigreturn puts the result back. The kernel half (arch/arm64/um/fastpath.c)
+ * rewrites hot "mov w8, #nr; svc #0" sites into "mov w8, #nr; b slot", where
+ * slot is a 32-byte trampoline in a page it maps into the guest mm:
+ *
+ *	+0	stp	x16, x17, [sp, #-16]!
+ *	+4	adr	x17, slot
+ *	+8	ldr	x16, =stub_fast_entry	(literal at the end of the page)
+ *	+12	br	x16
+ *	+16	ldp	x16, x17, [sp], #16	(fast return lands here)
+ *	+20	b	site + 4
+ *	+24	.quad	site + 4
+ *
+ * stub_fast_entry builds the same rt_sigframe the host would have, at the top
+ * of sigstack[], and runs the same handoff the SIGSYS handler runs. That skips
+ * the host's signal delivery and, in the common case, its rt_sigreturn:
+ *
+ *  - fast return: the kernel left pc/sp where the syscall was made, so the
+ *    registers are reloaded in userspace and the slot's epilogue branches back
+ *    to the site;
+ *  - anything else (a guest signal, a thread switch, a restart): a real
+ *    rt_sigreturn on the fake frame, which restores state exactly as the
+ *    SIGSYS path does.
+ *
+ * The trampoline uses 32 bytes below the guest's sp. AAPCS64 has no red zone
+ * and the host kernel writes signal frames in the same place, so code cannot
+ * rely on that memory.
+ */
+#ifndef __SYSDEP_STUB_FASTPATH_H
+#define __SYSDEP_STUB_FASTPATH_H
+
+#include <stddef.h>
+
+struct stub_fp_ctx_head {
+	unsigned int magic;
+	unsigned int size;
+};
+
+struct stub_fp_fpsimd {
+	struct stub_fp_ctx_head head;
+	unsigned int fpsr;
+	unsigned int fpcr;
+	__uint128_t vregs[32];
+};
+
+/* Starts with the host's struct rt_sigframe: siginfo, then ucontext. */
+struct stub_fast_frame {
+	siginfo_t info;
+	ucontext_t uc;
+	unsigned long slot;	/* trampoline slot we came through */
+	unsigned long ret_pc;	/* site + 4 */
+	unsigned long orig_sp;	/* guest sp at the site */
+	unsigned long pad;
+};
+
+_Static_assert(offsetof(struct stub_fast_frame, uc) == 128, "rt_sigframe layout");
+_Static_assert(offsetof(ucontext_t, uc_mcontext) == 176, "ucontext layout");
+_Static_assert(offsetof(mcontext_t, __reserved) == 288, "mcontext layout");
+_Static_assert(sizeof(struct stub_fast_frame) % 16 == 0, "frame alignment");
+_Static_assert(offsetof(struct stub_fast_frame, ret_pc) ==
+	       offsetof(struct stub_fast_frame, slot) + 8, "slot/ret_pc pair");
+_Static_assert(offsetof(struct stub_fast_frame, orig_sp) ==
+	       offsetof(struct stub_fast_frame, slot) + 16, "orig_sp");
+
+#define STUB_FAST_FRAME_OFF						\
+	((offsetof(struct stub_data, sigstack) +			\
+	  sizeof(((struct stub_data *)0)->sigstack) -			\
+	  sizeof(struct stub_fast_frame)) & ~15UL)
+
+#define STUB_FP_REGS_OFF \
+	(offsetof(struct stub_fast_frame, uc.uc_mcontext.regs))
+#define STUB_FP_FPSIMD_OFF \
+	(offsetof(struct stub_fast_frame, uc.uc_mcontext.__reserved))
+
+#define STUB_FP_FPSIMD_MAGIC	0x46508001
+#define STUB_AUDIT_ARCH_AARCH64	0xc00000b7
+#define STUB_SYS_SECCOMP	1
+#define STUB_PSTATE_NZCV	0xf0000000UL
+
+int stub_fast_syscall(struct stub_fast_frame *f);
+void stub_fast_entry_holder(void);
+
+/*
+ * Returns 0 to resume through the slot epilogue, 1 to rt_sigreturn on @f.
+ * Called by stub_fast_entry on sigstack[], with every guest register saved.
+ */
+int __section(".__syscall_stub") __used
+stub_fast_syscall(struct stub_fast_frame *f)
+{
+	struct stub_data *d = get_stub_data();
+	mcontext_t *mc = &f->uc.uc_mcontext;
+	struct stub_fp_fpsimd *fp = (void *)mc->__reserved;
+	struct stub_fp_ctx_head *end = (void *)(fp + 1);
+	unsigned long all = ~0UL, old = 0;
+
+	/* A host SIGSYS frame may have been built over ours since last time. */
+	fp->head.magic = STUB_FP_FPSIMD_MAGIC;
+	fp->head.size = sizeof(*fp);
+	end->magic = 0;
+	end->size = 0;
+	mc->fault_address = 0;
+
+	f->info.si_signo = SIGSYS;
+	f->info.si_errno = 0;
+	f->info.si_code = STUB_SYS_SECCOMP;
+	f->info.si_call_addr = (void *)mc->pc;
+	f->info.si_syscall = (int)mc->regs[8];
+	f->info.si_arch = STUB_AUDIT_ARCH_AARCH64;
+
+	stub_handoff(d, SIGSYS, &f->info, &f->uc);
+
+	while (__atomic_load_n(&d->fast_pending, __ATOMIC_RELAXED)) {
+		d->fast_pending = 0;
+		f->info.si_signo = SIGALRM;
+		f->info.si_code = 0x80;	/* SI_KERNEL */
+		stub_handoff(d, SIGALRM, &f->info, &f->uc);
+	}
+
+	if (mc->pc == f->ret_pc && mc->sp == f->orig_sp &&
+	    !(mc->pstate & ~STUB_PSTATE_NZCV))
+		return 0;	/* the entry code clears fast_busy */
+
+	/*
+	 * Slow return. Block everything first: once fast_busy is clear a
+	 * SIGALRM would run a real handoff, and the kernel could then hand
+	 * this frame to another guest thread before the sigreturn reads it.
+	 * rt_sigreturn reinstates the old mask from uc_sigmask atomically.
+	 */
+	stub_syscall4(__NR_rt_sigprocmask, SIG_SETMASK, (unsigned long)&all,
+		      (unsigned long)&old, sizeof(all));
+	f->uc.uc_flags = 0;
+	f->uc.uc_link = 0;
+	f->uc.uc_stack.ss_sp = (void *)d;
+	f->uc.uc_stack.ss_flags = 0;
+	f->uc.uc_stack.ss_size = STUB_DATA_PAGES * UM_KERN_PAGE_SIZE;
+	*(unsigned long *)&f->uc.uc_sigmask = old;
+	d->fast_busy = 0;
+	return 1;
+}
+
+/*
+ * Entered from a slot with x16 = this address, x17 = slot, and the guest's
+ * x16/x17 pushed at sp. The function wrapper is only there to give the asm
+ * its operands; nothing ever calls it.
+ */
+void __section(".__syscall_stub") __used __attribute__((naked))
+stub_fast_entry_holder(void)
+{
+	__asm__ volatile (
+	".globl stub_fast_entry\n"
+	".type stub_fast_entry, %%function\n"
+	"stub_fast_entry:\n"
+	"	stp	x0, x1, [sp, #-16]!\n"
+	/* x0 = stub data: the page after the one this code is in */
+	"	adr	x0, .\n"
+	"	and	x0, x0, #%c[pgmask]\n"
+	"	add	x0, x0, #%c[pgsz]\n"
+	"	mov	w1, #1\n"
+	"	str	w1, [x0, #%c[busy]]\n"
+	"	mov	x16, #%c[frame]\n"
+	"	add	x1, x0, x16\n"
+	"	add	x16, x1, #%c[regs]\n"
+	"	stp	x2, x3, [x16, #16]\n"
+	"	stp	x4, x5, [x16, #32]\n"
+	"	stp	x6, x7, [x16, #48]\n"
+	"	stp	x8, x9, [x16, #64]\n"
+	"	stp	x10, x11, [x16, #80]\n"
+	"	stp	x12, x13, [x16, #96]\n"
+	"	stp	x14, x15, [x16, #112]\n"
+	"	stp	x18, x19, [x16, #144]\n"
+	"	stp	x20, x21, [x16, #160]\n"
+	"	stp	x22, x23, [x16, #176]\n"
+	"	stp	x24, x25, [x16, #192]\n"
+	"	stp	x26, x27, [x16, #208]\n"
+	"	stp	x28, x29, [x16, #224]\n"
+	"	str	x30, [x16, #240]\n"
+	"	ldp	x2, x3, [sp]\n"			/* guest x0, x1 */
+	"	stp	x2, x3, [x16, #0]\n"
+	"	ldp	x2, x3, [sp, #16]\n"		/* guest x16, x17 */
+	"	stp	x2, x3, [x16, #128]\n"
+	"	add	x2, sp, #32\n"			/* guest sp */
+	"	ldr	x3, [x17, #24]\n"		/* site + 4 */
