+	if (n != sizeof(pid) || !cm || cm->cmsg_type != SCM_RIGHTS) {
+		zygote_off("recv", n < 0 ? -errno : n);
+		return -1;
+	}
+	spare_asked--;
+	spare_pid[spare_n] = pid;
+	memcpy(&spare_sock[spare_n], CMSG_DATA(cm), sizeof(int));
+	spare_n++;
+	return 1;
