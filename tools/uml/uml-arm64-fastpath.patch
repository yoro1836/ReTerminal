 			continue;
+		if (um_hostmap_find(ops->mm, va))
+			continue;
 		if (!ops->anchor(ops->mm_idp, va, PAGE_SIZE))
 			*slot = va;
 		return;
@@ -105,6 +250,8 @@ static void um_tlb_anchor_hole(struct vm_ops *ops, unsigned long addr,
 		va = chunk + ANCHOR_CHUNK - PAGE_SIZE;
 	else
 		return;
+	if (um_hostmap_find(ops->mm, va))
+		return;
 
 	if (!ops->anchor(ops->mm_idp, va, PAGE_SIZE))
 		*slot = va;
@@ -289,8 +436,11 @@ int um_tlb_sync(struct mm_struct *mm)
 	guard(spinlock_irqsave)(&mm->page_table_lock);
 	guard(spinlock_irqsave)(&mm->context.sync_tlb_lock);
 
+	if (mm != &init_mm && !list_empty(&mm->context.hostmaps))
+		um_hostmap_sync_dead(mm);
+
 	if (mm->context.sync_tlb_range_to == 0)
-		return 0;
+		goto hostmaps;
 
 	ops.mm_idp = &mm->context.id;
 	ops.mm = mm;
@@ -324,6 +474,10 @@ int um_tlb_sync(struct mm_struct *mm)
 	mm->context.sync_tlb_range_from = 0;
 	mm->context.sync_tlb_range_to = 0;
 
+hostmaps:
+	if (mm != &init_mm && !list_empty(&mm->context.hostmaps))
+		um_hostmap_sync_new(mm);
+
 	return ret;
 }
 
