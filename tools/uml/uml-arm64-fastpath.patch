+
+/* As um_prefault_around(): false if the mmap lock is gone. */
+static bool um_wp_around(struct mm_struct *mm, struct vm_area_struct *vma,
+			 unsigned long address, unsigned int flags)
+{
+	unsigned long span = (unsigned long)um_wp_around_pages << PAGE_SHIFT;
+	unsigned long start, end, addr;
+	pmd_t *pmd;
