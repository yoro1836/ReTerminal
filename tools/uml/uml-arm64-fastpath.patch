+/* Wrap a host fd the kernel process owns into a guest fd; closes it on error */
+static int hostfd_install(int host_fd)
+{
+	struct hostfd *h = kzalloc(sizeof(*h), GFP_KERNEL);
+	int fd;
+
+	if (!h) {
+		os_close_file(host_fd);
+		return -ENOMEM;
+	}
+	h->fd = host_fd;
+	fd = anon_inode_getfd("hostfd", &hostfd_fops, h, O_RDWR | O_CLOEXEC);
+	if (fd < 0) {
+		os_close_file(host_fd);
+		kfree(h);
+	}
+	return fd;
+}
