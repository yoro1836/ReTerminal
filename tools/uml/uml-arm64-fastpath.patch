+	pid = spare_pid[0];
+	sock = spare_sock[0];
+	spare_n--;
+	for (i = 0; i < spare_n; i++) {
+		spare_pid[i] = spare_pid[i + 1];
+		spare_sock[i] = spare_sock[i + 1];
+	}
+	zygote_ask();	/* a replacement, made while this one runs */
+
+	stub_fill_init_data(&init_data, stub_data);
+	memset(&ctrl, 0, sizeof(ctrl));
+	cm = CMSG_FIRSTHDR(&mh);
+	cm->cmsg_level = SOL_SOCKET;
+	cm->cmsg_type = SCM_RIGHTS;
+	cm->cmsg_len = CMSG_LEN(sizeof(int));
+	memcpy(CMSG_DATA(cm), &stub_sock, sizeof(int));
+
+	/* The stub's end is used non-blocking; the flag lives in the file. */
+	fcntl(stub_sock, F_SETFL, fcntl(stub_sock, F_GETFL) | O_NONBLOCK);
+
+	CATCH_EINTR(n = sendmsg(sock, &mh, MSG_NOSIGNAL));
