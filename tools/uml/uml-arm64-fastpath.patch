From b5c842c3ef50edcc8882acf11d281a91ec85bca8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 21 Nov 2026 05:41:39 +0000
Subject: [PATCH 11/39] um: stub_pin falls back to /proc/cpuinfo CPU part when
 sysfs CPU capacity is unreadable

---
 arch/um/os-Linux/skas/process.c | 47 ++++++++++++++++++++++++++++++++-
 1 file changed, 46 insertions(+), 1 deletion(-)

diff --git a/arch/um/os-Linux/skas/process.c b/arch/um/os-Linux/skas/process.c
index 851b0ebfe45c..ae927dfac43a 100644
--- a/arch/um/os-Linux/skas/process.c
+++ b/arch/um/os-Linux/skas/process.c
@@ -413,6 +413,49 @@ __uml_setup("stub_pin=", uml_stub_pin_setup,
 "    Pin the kernel thread to one host CPU and the stubs to the others.\n"
 "    Default: 1.\n\n");
 
+/*
+ * Fallback when sysfs is not readable (an app's SELinux domain may deny it):
+ * "CPU part" from /proc/cpuinfo, with Arm's in-order little cores ranked low.
+ */
+static int cpuinfo_capacity(int cpu)
+{
+	static const unsigned int little[] = {
+		0xd03, 0xd04, 0xd05, 0xd46, 0xd80,	/* A53 A35 A55 A510 A520 */
+	};
+	static short cap[64];
+	static int done;
+
+	if (!done) {
+		static char buf[32768];
+		int fd = open("/proc/cpuinfo", O_RDONLY | O_CLOEXEC);
+		int n = 0, r, cur = -1;
+		char *l;
+
+		done = 1;
+		if (fd < 0)
+			return 0;
+		while (n < (int)sizeof(buf) - 1 &&
+		       (r = read(fd, buf + n, sizeof(buf) - 1 - n)) > 0)
+			n += r;
+		close(fd);
+		buf[n] = 0;
+		for (l = buf; l && *l; l = strchr(l, '\n'), l = l ? l + 1 : NULL) {
+			unsigned int part, k;
+
+			if (sscanf(l, "processor : %d", &cur) == 1)
+				continue;
+			if (cur < 0 || cur >= 64 ||
+			    sscanf(l, "CPU part : %x", &part) != 1)
+				continue;
+			cap[cur] = 1024;
+			for (k = 0; k < sizeof(little) / sizeof(little[0]); k++)
+				if (part == little[k])
+					cap[cur] = 256;
+		}
+	}
+	return cap[cpu];
+}
+
 /* The host's relative CPU strength (arm64 cpu_capacity, else max freq), 0 if unknown. */
 static int cpu_capacity(int cpu)
 {
@@ -423,6 +466,8 @@ static int cpu_capacity(int cpu)
 	char path[96], buf[24];
 	int i, fd, n;
 
+	if (cpu < 0 || cpu >= 64)
+		return 0;
 	for (i = 0; i < 2; i++) {
 		snprintf(path, sizeof(path), f[i], cpu);
 		fd = open(path, O_RDONLY | O_CLOEXEC);
@@ -435,7 +480,7 @@ static int cpu_capacity(int cpu)
 			return strtoul(buf, NULL, 10);
 		}
 	}
-	return 0;
+	return cpuinfo_capacity(cpu);
 }
 
 /* Strongest CPU in mask; ties (or no capacity info) go to the highest number. */
-- 
2.43.0


