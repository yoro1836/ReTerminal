index 78e8e3dc3aae..cb0449bf62a9 100644
--- a/arch/arm64/um/fastpath.c
+++ b/arch/arm64/um/fastpath.c
@@ -75,7 +75,7 @@ static unsigned long fastpath_patched;
 
