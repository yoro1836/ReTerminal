+#define CLOCK_MONOTONIC		1
+#define CLOCK_REALTIME_COARSE	5
+#define CLOCK_MONOTONIC_COARSE	6
+#define CLOCK_BOOTTIME		7
+
+#define NR_clock_gettime	113
+#define NR_gettimeofday		169
+
+struct um_timespec {
+	long long tv_sec;
+	long long tv_nsec;
+};
+
+struct um_timeval {
+	long long tv_sec;
+	long long tv_usec;
+};
+
+extern const struct um_vdso_data _um_vdso_data
+	__attribute__((visibility("hidden")));
+
+static __always_inline long vdso_syscall2(long nr, long a, long b)
+{
+	register long x8 __asm__("x8") = nr;
+	register long x0 __asm__("x0") = a;
+	register long x1 __asm__("x1") = b;
+
+	__asm__ volatile("svc #0" : "+r" (x0) : "r" (x8), "r" (x1) : "memory");
+	return x0;
+}
+
+static __always_inline int vdso_read(const struct um_vdso_time *t, int coarse,
+				     struct um_timespec *ts)
+{
+	const struct um_vdso_data *d = &_um_vdso_data;
+	unsigned long long sec, ns, cyc;
+	unsigned int seq;
+
+	do {
+		seq = __atomic_load_n(&d->seq, __ATOMIC_ACQUIRE);
+		if (seq & 1)
+			continue;
+		if (!d->ok)
+			return -1;
+		sec = t->sec;
+		ns = t->nsec;
+		if (!coarse) {
+			__asm__ volatile("isb\n\tmrs %0, cntvct_el0" : "=r" (cyc));
+			ns += ((cyc - d->cycle_last) & d->mask) * d->mult;
+		}
+		ns >>= d->shift;
+		__atomic_thread_fence(__ATOMIC_ACQUIRE);
+	} while ((seq & 1) || seq != __atomic_load_n(&d->seq, __ATOMIC_RELAXED));
+
+	while (ns >= NSEC_PER_SEC) {
+		ns -= NSEC_PER_SEC;
+		sec++;
+	}
+	ts->tv_sec = sec;
+	ts->tv_nsec = ns;
+	return 0;
+}
+
+int __kernel_clock_gettime(int clock, struct um_timespec *ts);
+int __kernel_gettimeofday(struct um_timeval *tv, void *tz);
+
+int __kernel_clock_gettime(int clock, struct um_timespec *ts)
+{
+	const struct um_vdso_data *d = &_um_vdso_data;
+	int r = -1;
+
+	switch (clock) {
+	case CLOCK_REALTIME:
+		r = vdso_read(&d->real, 0, ts);
+		break;
+	case CLOCK_MONOTONIC:
+		r = vdso_read(&d->mono, 0, ts);
+		break;
+	case CLOCK_BOOTTIME:
+		r = vdso_read(&d->boot, 0, ts);
+		break;
+	case CLOCK_REALTIME_COARSE:
+		r = vdso_read(&d->real, 1, ts);
+		break;
+	case CLOCK_MONOTONIC_COARSE:
+		r = vdso_read(&d->mono, 1, ts);
+		break;
+	}
+	if (!r)
+		return 0;
+	return vdso_syscall2(NR_clock_gettime, clock, (long)ts);
+}
+
+int __kernel_gettimeofday(struct um_timeval *tv, void *tz)
+{
+	struct um_timespec ts;
+
+	if (tz || !tv || vdso_read(&_um_vdso_data.real, 0, &ts))
+		return vdso_syscall2(NR_gettimeofday, (long)tv, (long)tz);
+	tv->tv_sec = ts.tv_sec;
+	tv->tv_usec = (unsigned long long)ts.tv_nsec / 1000;
+	return 0;
+}
