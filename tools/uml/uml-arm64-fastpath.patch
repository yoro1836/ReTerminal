+/*
+ * One more host thread in the stub of @from, which the caller owns through the
+ * turnstile and which waits in its handoff: its data pages @to->stack get
+ * mapped at @addr, it gets a socket of its own and reports in with a SIGTRAP
+ * on its first resume (boot_pending). 0 on success.
+ */
+int stub_thread_new(struct mm_id *from, struct mm_id *to, unsigned long addr)
+{
+	struct stub_data *d = (void *)from->stack;
+	struct stub_syscall *sc;
+	unsigned long long offset;
+	int sv[2], idx, tid, pos, fd;
+
+	if (!using_seccomp || from->pid <= 0 || from->syscall_data_len < 0)
+		return -1;
+	fd = phys_mapping(uml_to_phys((void *)to->stack), &offset);
+	if (fd != stub_physmem_fd(from))
+		return -1;
+
+	if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK, 0, sv))
+		return -1;
+	/* The kernel's end blocks; the stub's is the non-blocking one. */
+	fcntl(sv[1], F_SETFL, 0);
+
+	stub_data_init((void *)to->stack);
+
+	if (map(from, addr, STUB_DATA_PAGES * UM_KERN_PAGE_SIZE,
+		PROT_READ | PROT_WRITE, fd, offset))
+		goto fail;
+	idx = get_stub_fd(from, sv[0]);
+	sc = syscall_stub_alloc(from);
+	pos = from->syscall_data_len - 1;
+	sc->syscall = STUB_SYSCALL_THREAD;
+	sc->mem.addr = addr;
+	sc->mem.fd = idx;
+	tid = pos < 0 || do_syscall_stub(from) < 0 ? -1 :
+		(int)d->syscall_data[pos].mem.length;
+	close(sv[0]);
+	if (tid <= 0) {
+		close(sv[1]);
+		return -1;
+	}
