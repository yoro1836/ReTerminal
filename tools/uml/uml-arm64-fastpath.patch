+/*
+ * Prefer an anonymous memfd: it lives in shmem whatever the tempdir is on.
+ * On Android the only writable tempdir is usually on f2fs, where every guest
+ * page would be file-backed flash with writeback behind it. Falls back to the
+ * tempdir if memfds are missing or cannot be mapped executable (W^X hosts).
+ * UML_NO_MEMFD in the environment forces the tempdir.
+ */
+static int __init make_memfd(void)
+{
+	static int state;	/* 0 untested, 1 usable, -1 not */
+	void *addr;
+	int fd;
+
+	if (state < 0 || getenv("UML_NO_MEMFD"))
+		return -1;
+
+	fd = syscall(__NR_memfd_create, "uml-physmem", 1 /* MFD_CLOEXEC */);
+	if (fd < 0)
+		goto bad;
+	if (state)
+		return fd;
+
+	if (ftruncate(fd, UM_KERN_PAGE_SIZE) < 0)
+		goto bad_close;
+	addr = mmap(NULL, UM_KERN_PAGE_SIZE, PROT_READ | PROT_WRITE | PROT_EXEC,
+		    MAP_SHARED, fd, 0);
+	if (addr == MAP_FAILED)
+		goto bad_close;
+	munmap(addr, UM_KERN_PAGE_SIZE);
+	if (ftruncate(fd, 0) < 0)
+		goto bad_close;
+
+	os_info("Guest memory: memfd (not %s)\n", tempdir);
+	state = 1;
+	return fd;
+
+bad_close:
+	close(fd);
+bad:
+	os_info("Guest memory: memfd unusable (%s), using %s\n",
+		strerror(errno), tempdir);
+	state = -1;
+	return -1;
+}
+
