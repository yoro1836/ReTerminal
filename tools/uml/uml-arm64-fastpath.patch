 {
 	static int done;
@@ -427,11 +472,27 @@ static unsigned long stub_pin_mask(void)
 	if (syscall(__NR_sched_getaffinity, 0, sizeof(m), &m) < 0 ||
 	    __builtin_popcountl(m) < 2)
 		return 0;
