+	pte_clear_bits(pte, _PAGE_NEEDSYNC | _PAGE_PROTONLY);
+	if (diff) {
+		pte_set_bits(pte, _PAGE_NEEDSYNC | _PAGE_PROTONLY);
+		um_tlb_mark_sync(mm, addr, addr + PAGE_SIZE);
+	}
+	*dst = pte;
