 #include <sched.h>
@@ -412,6 +413,50 @@ __uml_setup("stub_pin=", uml_stub_pin_setup,
 "    Pin the kernel thread to one host CPU and the stubs to the others.\n"
 "    Default: 1.\n\n");
 
+/* The host's relative CPU strength (arm64 cpu_capacity, else max freq), 0 if unknown. */
+static int cpu_capacity(int cpu)
+{
+	static const char *const f[] = {
+		"/sys/devices/system/cpu/cpu%d/cpu_capacity",
+		"/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq",
+	};
+	char path[96], buf[24];
+	int i, fd, n;
+
+	for (i = 0; i < 2; i++) {
+		snprintf(path, sizeof(path), f[i], cpu);
+		fd = open(path, O_RDONLY | O_CLOEXEC);
+		if (fd < 0)
+			continue;
+		n = read(fd, buf, sizeof(buf) - 1);
+		close(fd);
+		if (n > 0) {
+			buf[n] = 0;
+			return strtoul(buf, NULL, 10);
+		}
+	}
+	return 0;
+}
+
+/* Strongest CPU in mask; ties (or no capacity info) go to the highest number. */
+static int fastest_cpu(unsigned long m)
+{
+	int c, best = -1, cap = -1;
+
+	for (c = 0; c < 64; c++) {
+		int v;
+
+		if (!(m >> c & 1))
+			continue;
+		v = cpu_capacity(c);
+		if (v >= cap) {
+			cap = v;
+			best = c;
+		}
+	}
+	return best;
+}
+
